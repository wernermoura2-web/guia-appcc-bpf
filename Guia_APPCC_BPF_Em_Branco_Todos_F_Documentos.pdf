u00eancia n\\u00e3o constitui uma etapa de elimina\\u00e7\\u00e3o do perigo."}],"P":3,"statusField":"estado_q_p6c4_4.3.3","resultField":"peso_q_p6c4_4.3.3","template":"Frases_4_3_3_S","editorPrefix":"F_4_3_3_S_"},"q_p6c1_4.3.4":{"rects":[[175.25,171.5,213.875,180.25],[214.875,171.5,253.5,180.25]],"page":5,"col":1,"code":"4.3.4","proc":"4.3","allowNA":false,"classField":"classe_p6_4.3.4","frases":[{"texto":"A inspe\\u00e7\\u00e3o visual do reservat\\u00f3rio deve ser efetuada na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.","cat":"PC","P":4,"orientacao":"Conferir frequ\\u00eancia e registros da inspe\\u00e7\\u00e3o visual interna, identifica\\u00e7\\u00e3o do reservat\\u00f3rio e achados; observar condi\\u00e7\\u00f5es internas e encaminhamento dos desvios.","consideracao":"Inspe\\u00e7\\u00e3o, ensaio ou verifica\\u00e7\\u00e3o de apoio; n\\u00e3o constitui etapa de redu\\u00e7\\u00e3o do perigo.","providencia":"","fundamento":"Inspe\\u00e7\\u00e3o, ensaio ou verifica\\u00e7\\u00e3o de apoio; n\\u00e3o constitui etapa de redu\\u00e7\\u00e3o do perigo."},{"texto":"Caso seja constatada a presen\\u00e7a de incrusta\\u00e7\\u00f5es e de outras altera\\u00e7\\u00f5es que possam comprometer a qualidade higi\\u00eanico-sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural devem ser revistas as opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o e adotadas as medidas corretivas necess\\u00e1rias.","cat":"PPRO","P":4,"orientacao":"Verificar incrusta\\u00e7\\u00f5es e altera\\u00e7\\u00f5es; conferir bloqueio, revis\\u00e3o da higieniza\\u00e7\\u00e3o, corre\\u00e7\\u00f5es e nova libera\\u00e7\\u00e3o do reservat\\u00f3rio.","consideracao":"Controle operacional dirigido \\u00e0 preven\\u00e7\\u00e3o da contamina\\u00e7\\u00e3o, com crit\\u00e9rios de a\\u00e7\\u00e3o.","providencia":"","fundamento":"Controle operacional dirigido \\u00e0 preven\\u00e7\\u00e3o da contamina\\u00e7\\u00e3o, com crit\\u00e9rios de a\\u00e7\\u00e3o."}],"P":4,"stat