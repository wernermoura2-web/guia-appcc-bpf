0e7\\u00e3o b\\u00e1sica de estrutura, organiza\\u00e7\\u00e3o, pessoal ou documenta\\u00e7\\u00e3o."}],"P":3,"statusField":"estado_q_p2c4_4.2.2","resultField":"peso_q_p2c4_4.2.2","template":"Frases_4_2_2_S","editorPrefix":"F_4_2_2_S_"},"q_p2c1_4.2.7":{"rects":[[175.25,132.5,213.875,142.0],[214.875,132.5,253.5,142.0]],"page":1,"col":1,"code":"4.2.7","proc":"4.2","allowNA":false,"classField":"classe_p2_4.2.7","frases":[{"texto":"A higieniza\\u00e7\\u00e3o da canaliza\\u00e7\\u00e3o deve garantir a manuten\\u00e7\\u00e3o das condi\\u00e7\\u00f5es higi\\u00eanico-sanit\\u00e1rias satisfat\\u00f3rias e minimizar o risco de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.","cat":"PCC","P":3,"orientacao":"Conferir POP validado, concentra\\u00e7\\u00e3o do saneante, tempo de contato, temperatura quando aplic\\u00e1vel, enx\\u00e1gue e crit\\u00e9rios de libera\\u00e7\\u00e3o. Incluir condutividade em linha como medida complementar: sensor adequado e calibrado, compensa\\u00e7\\u00e3o de temperatura, valor de base da \\u00e1gua, limites de desvio validados, registro cont\\u00ednuo e alarme ou bloqueio definido. Confrontar com ensaio espec\\u00edfico de res\\u00edduo de saneante e verifica\\u00e7\\u00e3o microbiol\\u00f3gica; ATP \\u00e9 complementar e n\\u00e3o substitui an\\u00e1lise microbiol\\u00f3gica. Verificar a\\u00e7\\u00f5es corretivas, bloqueio do fluxo/lotes afetados, rastreabilidade e autoriza\\u00e7\\u00e3o de retomada.","consideracao":"PCC adotado na revis\\u00e3o t\\u00e9cnica da higieniza\\u00e7\\u00e3o: perigos biol\\u00f3gicos \(microrganismos e biofilme\) e qu\\u00edmicos \(res\\u00edduos de saneantes\), com propaga\\u00e7\\u00e3o ao produto e sem etapa posterior demonstrada que assegure seu controle. Exigir valida\\u00e7\\u00e3o da higieniza\\u00e7\\u00e3o e do enx\\u00e1gue, limites cr\\u00edticos fundamentados, monitoramento oportuno, bloqueio do fluxo e do produto afetado, corre\\u00e7\\u00e3o e libera\\u00e7\\u00e3o documentada. Condutividade em linha \\u00e9 medida complementar para acompanhar o enx\\u00e1gue e detectar desvios em rela\\u00e7\\u00e3o \\u00e0 \\u00e1gua de refer\\u00eancia; isoladamente n\\u00e3o comprova aus\\u00eancia de microrganismos ou de todos os res\\u00edduos.","providencia":"Comprovar higieniza\\u00e7\\u00e3o e enx\\u00e1gue validados, monitoramento dos limites cr\\u00edticos e condutividade em linha complementar, com bloqueio e libera\\u00e7\\u00e3o documentados.","fundamento":"PCC adotado na revis\\u00e3o t\\u00e9cnica da higieniza\\u00e7\\u00e3o: perigos biol\\u00f3gicos \(microrganismos e biofilme\) e qu\\u00edmicos \(res\\u00edduos de saneantes\), com propaga\\u00e7\\u00e3o ao produto e sem etapa posterior demonstrada que assegure seu controle. Exigir valida\\u00e7\\u00e3o da higieniza\\u00e7\\u00e3o e do enx\\u00e1gue, limites cr\\u00edticos fundamentados, monitoramento oportuno, bloqueio do fluxo e do produto afetado, corre\\u00e7\\u00e3o e libera\\u00e7\\u00e3o documentada. Condutividade em linha \\u00e9 medida complementar para acompanhar o enx\\u00e1gue e detectar desvios em rela\\u00e7\\u00e3o \\u00e0 \\u00e1gua de refer\\u00eancia; isoladamente n\\u00e3o comprova aus\\u00eancia de microrganismos ou de todos os res\\u00edduos."},{"texto":"Devem ser mantidos registros das opera\\u00e7\\u00f5es.","cat":"PPR","P":3,"orientacao":"Conferir registros de higieniza\\u00e7\\u00e3o por trecho da canaliza\\u00e7\\u00e3o, com data, par\\u00e2metros executados, respons\\u00e1vel e desvios identificados.","consideracao":"Condi\\u00e7\\u00e3o b\\u00e1sica de estrutura, organiza\\u00e7\\u00e3o, pessoal ou documenta\\u00e7\\u00e3o.","providencia":"","fundamento":"Condi\\u00e7\\u00e3o b\\u00e1sica de estrutura, organiza\\u00e7\\u00e3o, pessoal ou documenta\\u00e7\\u00e3o."},{"texto":"A higieniza\\u00e7\\u00e3o da canaliza\\u00e7\\u00e3o deve ser realizada por funcion\\u00e1rios comprovadamente capacitados.","cat":"PPR","P":3,"orientacao":"Conferir certificados e registros de capacita\\u00e7\\u00e3o dos executores da higieniza\\u00e7\\u00e3o da canaliza\\u00e7\\u00e3o; verificar dom\\u00ednio do POP e da resposta aos desvios.","fundamento":"Condi\\u00e7\\u00e3o b\\u00e1sica de estrutura, pessoal ou documenta\\u00e7\\u00e3o de apoio; n\\u00e3o constitui etapa de elimina\\u00e7\\u00e3o do perigo.","consideracao":"Condi\\u00e7\\u00e3o b\\u00e1sica de estrutura, pessoal ou documenta\\u00e7\\u00e3o de apoio; n\\u00e3o constitui etapa de elimina\\u00e7\\u00e3o do perigo.","providencia":""}],"P":4,"statusField":"estado_q_p2c1_4.2.7","resultField":"peso_q_p2c1_4.2.7","template":"Frases_4_2_7_S","editorPrefix":"F_4_2_7_S_"},"q_p2c2_4.2.7":{"rects":[[258.5,132.5,297.5,142.0],[298.5,132.5,337.5,142.0]],"page":1,"col":2,"code":"4.2.7","proc":"4.2","allowNA":false,"classField":"classe_p2_4.2.7","frases":[{"texto":"A higieniza\\u00e7\\u00e3o da canaliza\\u00e7\\u00e3o deve garantir a manuten\\u00e7\\u00e3o das condi\\u00e7\\u00f5es higi\\u00eanico-sanit\\u00e1rias satisfat\\u00f3rias e minimizar o risco de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.","cat":"PCC","P":3,"orientacao":"Conferir POP validado, concentra\\u00e7\\u00e3o do saneante, tempo de contato, temperatura quando aplic\\u00e1vel, enx\\u00e1gue e crit\\u00e9rios de libera\\u00e7\\u00e3o. Incluir condutividade em linha como medida complementar: sensor adequado e calibrado, compensa\\u00e7\\u00e3o de temperatura, valor de base da \\u00e1gua, limites de desvio validados, registro cont\\u00ednuo e alarme ou bloqueio definido. Confrontar com ensaio espec\\u00edfico de res\\u00edduo de saneante e verifica\\u00e7\\u00e3o microbiol\\u00f3gica; ATP \\u00e9 complementar e n\\u00e3o substitui an\\u00e1lise microbiol\\u00f3gica. Verificar a\\u00e7\\u00f5es corretivas, bloqueio do fluxo/lotes afetados, rastreabilidade e autoriza\\u00e7\\u00e3o de retomada.","consideracao":"PCC adotado na revis\\u00e3o t\\u00e9cnica da higieniza\\u00e7\\u00e3o: perigos