efix": "F_4_3_2_S_"}, "q_p3c1_4.3.3": {"rects": [[175.25, 158.75, 213.875, 167.5], [214.875, 158.75, 253.5, 167.5]], "page": 2, "col": 1, "code": "4.3.3", "proc": "4.3", "allowNA": false, "classField": "classe_p3_4.3.3", "frases": [{"texto": "O reservat\\u00f3rio deve possuir extravasor, protegido por tela milimetrada, dotado de filtro de ar microbiol\\u00f3gico, v\\u00e1lvula de reten\\u00e7\\u00e3o ou fecho h\\u00eddrico em forma de sif\\u00e3o para impedir que o n\\u00edvel de \\u00e1gua atinja a parte superior.", "cat": "PPRO", "P": 3}, {"texto": "Deve possuir um dispositivo para esvaziamento em n\\u00edvel inferior para fins de higieniza\\u00e7\\u00e3o e uma torneira espec\\u00edfica para coleta de amostra, instalada no in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua para o envase.", "cat": "PC", "P": 3}, {"texto": "Os elementos filtrantes devem ser verificados e trocados na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial, sendo mantidos os registros.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p3c1_4.3.3", "resultField": "peso_q_p3c1_4.3.3", "template": "Frases_4_1_2_S", "editorPrefix": "F_4_1_2_S_"}, "q_p3c2_4.3.3": {"rects": [[258.5, 158.75, 297.5, 167.5], [298.5, 158.75, 337.5, 167.5]], "page": 2, "col": 2, "code": "4.3.3", "proc": "4.3", "allowNA": false, "classField": "classe_p3_4.3.3", "frases": [{"texto": "O reservat\\u00f3rio deve possuir extravasor, protegido por tela milimetrada, dotado de filtro de ar microbiol\\u00f3gico, v\\u00e1lvula de reten\\u00e7\\u00e3o ou fecho h\\u00eddrico em forma de sif\\u00e3o para impedir que o n\\u00edvel de \\u00e1gua atinja a parte superior.", "cat": "PPRO", "P": 3}, {"texto": "Deve possuir um dispositivo para esvaziamento em n\\u00edvel inferior para fins de higieniza\\u00e7\\u00e3o e uma torneira espec\\u00edfica para coleta de amostra, instalada no in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua para o envase.", "cat": "PC", "P": 3}, {"texto": "Os elementos filtrantes devem ser verificados e trocados na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial, sendo mantidos os registros.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p3c2_4.3.3", "resultField": "peso_q_p3c2_4.3.3", "template": "Frases_4_1_2_S", "editorPrefix": "F_4_1_2_S_"}, "q_p3c3_4.3.3": {"rects": [[342.5, 158.75, 381.125, 167.5], [382.125, 158.75, 420.75, 167.5]], "page": 2, "col": 3, "code": "4.3.3", "proc": "4.3", "allowNA": false, "classField": "classe_p3_4.3.3", "frases": [{"texto": "O reservat\\u00f3rio deve possuir extravasor, protegido por tela milimetrada, dotado de filtro de ar microbiol\\u00f3gico, v\\u00e1lvula de reten\\u00e7\\u00e3o ou fecho h\\u00eddrico em forma de sif\\u00e3o para impedir que o n\\u00edvel de \\u00e1gua atinja a parte superior.", "cat": "PPRO", "P": 3}, {"texto": "Deve possuir um dispositivo para esvaziamento em n\\u00edvel inferior para fins de higieniza\\u00e7\\u00e3o e uma torneira espec\\u00edfica para coleta de amostra, instalada no in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua para o envase.", "cat": "PC", "P": 3}, {"texto": "Os elementos filtrantes devem ser verificados e trocados na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial, sendo mantidos os registros.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p3c3_4.3.3", "resultField": "peso_q_p3c3_4.3.3", "template": "Frases_4_1_2_S", "editorPrefix": "F_4_1_2_S_"}, "q_p3c4_4.3.3": {"rects": [[425.75, 158.75, 464.75, 167.5], [465.75, 158.75, 504.75, 167.5]], "page": 2, "col": 4, "code": "4.3.3", "proc": "4.3", "allowNA": false, "classField": "classe_p3_4.3.3", "frases": [{"texto": "O reservat\\u00f3rio deve possuir extravasor, protegido por tela milimetrada, dotado de filtro de ar microbiol\\u00f3gico, v\\u00e1lvula de reten\\u00e7\\u00e3o ou fecho h\\u00eddrico em forma de sif\\u00e3o para impedir que o n\\u00edvel de \\u00e1gua atinja a parte superior.", "cat": "PPRO", "P": 3}, {"texto": "Deve possuir um dispositivo para esvaziamento em n\\u00edvel inferior para fins de higieniza\\u00e7\\u00e3o e uma torneira espec\\u00edfica para coleta de amostra, instalada no in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua para o envase.", "cat": "PC", "P": 3}, {"texto": "Os elementos filtrantes devem ser verificados e trocados na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial, sendo mantidos os registros.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p3c4_4.3.3", "resultField": "peso_q_p3c4_4.3.3", "template": "Frases_4_1_2_S", "editorPrefix": "F_4_1_2_S_"}, "q_p3c1_4.3.4": {"rects": [[175.25, 171.5, 213.875, 180.25], [214.875, 171.5, 253.5, 180.25]], "page": 2, "col": 1, "code": "4.3.4", "proc": "4.3", "allowNA": false, "classField": "classe_p3_4.3.4", "frases": [{"texto": "A inspe\\u00e7\\u00e3o visual do reservat\\u00f3rio deve ser efetuada na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.", "cat": "PPRO", "P": 4}, {"texto": "Caso seja constatada a presen\\u00e7a de incrusta\\u00e7\\u00f5es e de outras altera\\u00e7\\u00f5es que possam comprometer a qualidade higi\\u00eanico-sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural devem ser revistas as opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o e adotadas as medidas corretivas necess\\u00e1rias.", "cat": "PPRO", "P": 4}], "P": 4, "statusField": "estado_q_p3c1_4.3.4", "resultField": "peso_q_p3c1_4.3.4", "template": "Frases_4_3_4_S", "editorPrefix": "F_4_3_4_S_"}, "q_p3c2_4.3.4": {"rects": [[258.5, 171.5, 297.5, 180.25], [298.5, 171.5, 337.5, 180.25]], "page": 2, "col": 2, "code": "4.3.4", "proc": "4.3", "allowNA": false, "classField": "classe_p3_4.3.4", "frases": [{"texto": "A inspe\\u00e7\\u00e3o visual do reservat\\u00f3rio deve ser efetuada na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.", "cat": "PPRO", "P": 4}, {"texto": "Caso 