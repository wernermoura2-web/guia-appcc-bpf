+\){var a=compacto\(t\),at=a.text.indexOf\(o\);if\(at<0\)break;t=t.substring\(0,a.pos[at]\)+t.substring\(a.pos[at+o.length-1]+1\);}}var marker=t.indexOf\('Detalhamento das frases:'\);if\(marker>=0\)t=t.substring\(0,marker\);return t.replace\(/^\\s+|\\s+$/g,''\);}\nfunction quebrarLinhas\(text,width,font\){var out=[],parts=normalizarTexto\(text\).split\('\\n'\),metrics=CFG.larguras||{};for\(var pi=0;pi<parts.length;pi++\){var line=parts[pi];if\(line===''\){out.push\(''\);continue;}while\(line.length\){var w=0,lastSpace=-1,i=0;for\(;i<line.length;i++\){w+=\(metrics[line.charAt\(i\)]||0.55\)*font;if\(w>width&&i>0\)break;if\(line.charAt\(i\)===' '\)lastSpace=i;}if\(i>=line.length\){out.push\(line\);line='';}else{var cut=lastSpace>0?lastSpace:i;out.push\(line.substring\(0,cut\)\);line=line.substring\(cut\).replace\(/^ +/,''\);}}}return out;}\nfunction distribuirObservacao\(base,text\){var c=CFG.observacoes[base];if\(!c\)return;var font=c.font,lines,cap;for\(;font>=6;font-=0.5\){cap=Math.max\(1,Math.floor\(\(c.height-7\)/\(font*1.3\)\)\);lines=quebrarLinhas\(text,c.width-9,font\);if\(lines.length<=2*cap||font<=6\)break;}var left=lines.slice\(0,cap\).join\('\\r'\),right=lines.slice\(cap\).join\('\\r'\),f=this.getField\(c.left\),g=this.getField\(c.right\);if\(f\){f.textSize=font;f.value=left;}if\(g\){g.textSize=font;g.value=right;}}\nfunction atualizarObservacoes\(\){if\(OBS_BUSY\)return;OBS_BUSY=true;try{var d=dados.call\(this\),out={};for\(var name in CFG.observacoes\)out[name]=[];for\(var key in d.u\){var c=CFG.itens[key];if\(!c\)continue;var name=c.page===11||c.page===12?'obs_p'+\(c.page+1\)+'_'+c.code:'obs_gerais_p'+\(c.page+1\);if\(!out[name]\)out[name]=[];var rs=d.u[key];for\(var i=0;i<rs.length;i++\)if\(rs[i].a==='N'||\(rs[i].o&&String\(rs[i].o\).replace\(/\\s/g,''\)\)\)out[name].push\(\(rs[i].a==='N'?'NC ':''\)+'F'+\(i+1\)+' | Item '+c.code+' | '+nomeUnidade.call\(this,c\)+\(rs[i].o?': '+normalizarTexto\(rs[i].o\):''\)\);}\nfor\(var base in CFG.observacoes\){var c=CFG.observacoes[base];if\(d.manual[base]===undefined\){var initial=normalizarTexto\(val.call\(this,c.left\)\)+'\\n'+normalizarTexto\(val.call\(this,c.right\)\);d.manual[base]=retirarAutomatico\(initial,d.generated[base]||''\);}var block=out[base]&&out[base].length?'Detalhamento das frases:\\n'+out[base].join\('\\n'\):'';d.generated[base]=block;var manual=d.manual[base]||'',full=manual+\(manual&&block?'\\n\\n':''\)+block;d.full[base]=full;distribuirObservacao.call\(this,base,full\);}gravar.call\(this,d\);}finally{OBS_BUSY=false;}}\nfunction editarObservacoes\(base,col,novo\){if\(OBS_BUSY||BUSY\)return;var c=CFG.observacoes[base];if\(!c\)return;var d=dados.call\(this\),left=col===1?novo:val.call\(this,c.left\),right=col===2?novo:val.call\(this,c.right\);d.manual[base]=retirarAutomatico\(normalizarTexto\(left\)+'\\n'+normalizarTexto\(right\),d.generated[base]||''\);gravar.call\(this,d\);atualizarObservacoes.call\(this\);}\nfunction excluirPaginaFrases\(\){var doc=CLOSE_DOC,pg=CLOSE_PAGE;CLOSE_DOC=null;CLOSE_PAGE=null;if\(!doc||pg===null\)return;try{doc.deletePages\(pg,pg\);}catch\(e\){app.alert\('As respostas foram salvas. O leitor manteve a p\341gina auxiliar aberta: '+e\);}}\nfunction fecharFrases\(\){if\(!ACTIVE\)recuperarEditor.call\(this\);if\(!ACTIVE||SAVE_BUSY||EDITOR_BUSY\)return;guardarFrases.call\(this\);var pg=ACTIVE.page,back=ACTIVE.returnPage;ACTIVE=null;put.call\(this,'editor_ativo',''\);this.pageNum=back;CLOSE_DOC=this;CLOSE_PAGE=pg;try{app.setTimeOut\('excluirPaginaFrases\(\);',200\);}catch\(e\){app.alert\('As respostas foram salvas e o processo foi reaberto. Este leitor manteve a p\341gina auxiliar.'\);}}\nfunction atualizarDocumento\(n,entrada\){var s=this.getField\('doc_legal_'+n+'_situacao'\),a=this.getField\('doc_legal_'+n+'_atende'\);if\(!s||!a\)return;var v=entrada!==undefined?String\(entrada\):s.valueAsString;if\(v==='Entregue'\){a.readonly=false;a.fillColor=color.white;}else if\(v==='N\343o entregue'\){a.value='N\303O';a.readonly=true;a.fillColor=['G',0.92];}else{a.value='';a.readonly=true;a.fillColor=['G',0.92];}}\nfunction selecionarFonte\(i,v\){put.call\(this,'tipo_captacao_'+i,v\);for\(var j=0;j<2;j++\){var b=this.getField\('fonte_'+i+'_'+j\);if\(b\)b.fillColor=\(v===\(j===0?'Po\347o':'Surg\352ncia'\)\)?['G',0.82]:color.white;}}\nfunction somarVazoes\(alterado,entrada\){var ns=['campo_p1_13','campo_p1_15','campo_p1_14','campo_p1_16'],sum=0,dec=0,n=0;for\(var i=0;i<ns.length;i++\){var s=String\(ns[i]===alterado?entrada:val.call\(this,ns[i]\)\).replace\(/\\s/g,''\);if\(!s\)continue;var parts=s.split\(','\);if\(parts.length===1\)parts=s.split\('.'\);var x=Number\(s.replace\(',','.'\)\);if\(!isFinite\(x\)\)continue;sum+=x;n++;dec=Math.max\(dec,parts.length>1?parts[1].length:0\);}put.call\(this,'vazao_total',n?sum.toFixed\(Math.min\(8,dec\)\).replace\('.',','\):''\);}\nfunction limparPagina\(pi\){if\(ACTIVE\)fecharFrases.call\(this\);var d=dados.call\(this\);for\(var k in CFG.itens\)if\(CFG.itens[k].page===pi\){delete d.u[k];if\(d.det\)delete d.det[k];}gravar.call\(this,d\);atualizarObservacoes.call\(this\);recalcularTudo.call\(this\);}\nfunction iniciar\(\){try{var s=val.call\(this,'editor_ativo'\);if\(s\){var a=JSON.parse\(s\),f=this.getField\(a.prefix+'ed_title'\);if\(f\){ACTIVE=a;if\(typeof f.page==='number'&&f.page>=0\)ACTIVE.page=f.page;}}for\(var n=1;n<=8;n++\)atualizarDocumento.call\(this,n\);migrarResponsabilidade.call\(this\);migrarControleQualidade.call\(this\);recalcularTudo.call\(this\);atualizarObservacoes.call\(this\);if\(ACTIVE\)mostrarEditor.call\(this\);}catch\(e\){}}\niniciar.call\(this\);\n\nfunction anexarFoto\(nome\){try{var f=this.getField\(nome\);f.buttonPosition=1;f.buttonFitBounds=true;f.buttonScaleHow=0;f.buttonScaleWhen=0;f.buttonAlignX=50;f.buttonAlignY=50;f.buttonImportIcon\(\);}catch\(e\){app.alert\('O leitor n\343o permitiu anexar a imagem: '+e\);}}\nfunction girarFoto\(nome\){var f=this.getField\(nome\);if\(f\){f.rotation=\(\(Number\(f.rotation\)||0\)+90\)%360;f.buttonPosition=1;f.buttonFitBounds=true;f.buttonScaleHow=0;f.buttonScaleWhen=0;}}\n)>>
endobj

