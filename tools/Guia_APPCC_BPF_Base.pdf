<</Type/Action/S/JavaScript/JS(var CFG={"itens": {"q_p1c1_4.1.1": {"rects": [[175.25, 266.75, 213.875, 276.25], [214.875, 266.75, 253.5, 276.25]], "page": 0, "col": 1, "code": "4.1.1", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.1", "frases": [{"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser pavimentada e dispor de um sistema de drenagem de \\u00e1guas pluviais de modo a impedir a infiltra\\u00e7\\u00e3o de contaminantes, n\\u00e3o comprometendo a qualidade sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PPRO", "P": 3}, {"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida limpa e livre de focos de insalubridade.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p1c1_4.1.1", "resultField": "peso_q_p1c1_4.1.1", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c2_4.1.1": {"rects": [[258.5, 266.75, 297.5, 276.25], [298.5, 266.75, 337.5, 276.25]], "page": 0, "col": 2, "code": "4.1.1", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.1", "frases": [{"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser pavimentada e dispor de um sistema de drenagem de \\u00e1guas pluviais de modo a impedir a infiltra\\u00e7\\u00e3o de contaminantes, n\\u00e3o comprometendo a qualidade sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PPRO", "P": 3}, {"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida limpa e livre de focos de insalubridade.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p1c2_4.1.1", "resultField": "peso_q_p1c2_4.1.1", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c3_4.1.1": {"rects": [[342.5, 266.75, 381.125, 276.25], [382.125, 266.75, 420.75, 276.25]], "page": 0, "col": 3, "code": "4.1.1", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.1", "frases": [{"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser pavimentada e dispor de um sistema de drenagem de \\u00e1guas pluviais de modo a impedir a infiltra\\u00e7\\u00e3o de contaminantes, n\\u00e3o comprometendo a qualidade sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PPRO", "P": 3}, {"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida limpa e livre de focos de insalubridade.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p1c3_4.1.1", "resultField": "peso_q_p1c3_4.1.1", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c4_4.1.1": {"rects": [[425.75, 266.75, 464.75, 276.25], [465.75, 266.75, 504.75, 276.25]], "page": 0, "col": 4, "code": "4.1.1", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.1", "frases": [{"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser pavimentada e dispor de um sistema de drenagem de \\u00e1guas pluviais de modo a impedir a infiltra\\u00e7\\u00e3o de contaminantes, n\\u00e3o comprometendo a qualidade sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PPRO", "P": 3}, {"texto": "A \\u00e1rea circundante \\u00e0 casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida limpa e livre de focos de insalubridade.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p1c4_4.1.1", "resultField": "peso_q_p1c4_4.1.1", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c1_4.1.2": {"rects": [[175.25, 280.25, 213.875, 289.75], [214.875, 280.25, 253.5, 289.75]], "page": 0, "col": 1, "code": "4.1.2", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.2", "frases": [{"texto": "A casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida em condi\\u00e7\\u00e3o higi\\u00eanico-sanit\\u00e1ria satisfat\\u00f3ria, livre de infiltra\\u00e7\\u00f5es, rachaduras, fendas e outras altera\\u00e7\\u00f5es.", "P": 3, "cat": "PPRO"}, {"texto": "No in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua mineral natural ou da \\u00e1gua natural deve ser instalada torneira espec\\u00edfica para a coleta de amostras.", "P": 3, "cat": "PC"}], "P": 3, "statusField": "estado_q_p1c1_4.1.2", "resultField": "peso_q_p1c1_4.1.2", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c2_4.1.2": {"rects": [[258.5, 280.25, 297.5, 289.75], [298.5, 280.25, 337.5, 289.75]], "page": 0, "col": 2, "code": "4.1.2", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.2", "frases": [{"texto": "A casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida em condi\\u00e7\\u00e3o higi\\u00eanico-sanit\\u00e1ria satisfat\\u00f3ria, livre de infiltra\\u00e7\\u00f5es, rachaduras, fendas e outras altera\\u00e7\\u00f5es.", "P": 3, "cat": "PPRO"}, {"texto": "No in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua mineral natural ou da \\u00e1gua natural deve ser instalada torneira espec\\u00edfica para a coleta de amostras.", "P": 3, "cat": "PC"}], "P": 3, "statusField": "estado_q_p1c2_4.1.2", "resultField": "peso_q_p1c2_4.1.2", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c3_4.1.2": {"rects": [[342.5, 280.25, 381.125, 289.75], [382.125, 280.25, 420.75, 289.75]], "page": 0, "col": 3, "code": "4.1.2", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.2", "frases": [{"texto": "A casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida em condi\\u00e7\\u00e3o higi\\u00eanico-sanit\\u00e1ria satisfat\\u00f3ria, livre de infiltra\\u00e7\\u00f5es, rachaduras, fendas e outras altera\\u00e7\\u00f5es.", "P": 3, "cat": "PPRO"}, {"texto": "No in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua mineral natural ou da \\u00e1gua natural deve ser instalada torneira espec\\u00edfica para a coleta de amostras.", "P": 3, "cat": "PC"}], "P": 3, "statusField": "estado_q_p1c3_4.1.2", "resultField": "peso_q_p1c3_4.1.2", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c4_4.1.2": {"rects": [[425.75, 280.25, 464.75, 289.75], [465.75, 280.25, 504.75, 289.75]], "page": 0, "col": 4, "code": "4.1.2", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.2", "frases": [{"texto": "A casa de prote\\u00e7\\u00e3o da capta\\u00e7\\u00e3o deve ser mantida em condi\\u00e7\\u00e3o higi\\u00eanico-sanit\\u00e1ria satisfat\\u00f3ria, livre de infiltra\\u00e7\\u00f5es, rachaduras, fendas e outras altera\\u00e7\\u00f5es.", "P": 3, "cat": "PPRO"}, {"texto": "No in\\u00edcio da canaliza\\u00e7\\u00e3o de distribui\\u00e7\\u00e3o da \\u00e1gua mineral natural ou da \\u00e1gua natural deve ser instalada torneira espec\\u00edfica para a coleta de amostras.", "P": 3, "cat": "PC"}], "P": 3, "statusField": "estado_q_p1c4_4.1.2", "resultField": "peso_q_p1c4_4.1.2", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c1_4.1.3": {"rects": [[175.25, 293.75, 213.875, 303.25], [214.875, 293.75, 253.5, 303.25]], "page": 0, "col": 1, "code": "4.1.3", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.3", "frases": [{"texto": "As edifica\\u00e7\\u00f5es, as instala\\u00e7\\u00f5es, a canaliza\\u00e7\\u00e3o e os equipamentos da capta\\u00e7\\u00e3o devem ser submetidos \\u00e0 limpeza e, se for o caso, \\u00e0 desinfec\\u00e7\\u00e3o, de forma a minimizar os riscos de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "P": 3, "cat": "PPHO"}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e de desinfec\\u00e7\\u00e3o devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados e mantidos registros.", "P": 3, "cat": "PPHO"}], "P": 3, "statusField": "estado_q_p1c1_4.1.3", "resultField": "peso_q_p1c1_4.1.3", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c2_4.1.3": {"rects": [[258.5, 293.75, 297.5, 303.25], [298.5, 293.75, 337.5, 303.25]], "page": 0, "col": 2, "code": "4.1.3", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.3", "frases": [{"texto": "As edifica\\u00e7\\u00f5es, as instala\\u00e7\\u00f5es, a canaliza\\u00e7\\u00e3o e os equipamentos da capta\\u00e7\\u00e3o devem ser submetidos \\u00e0 limpeza e, se for o caso, \\u00e0 desinfec\\u00e7\\u00e3o, de forma a minimizar os riscos de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "P": 3, "cat": "PPHO"}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e de desinfec\\u00e7\\u00e3o devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados e mantidos registros.", "P": 3, "cat": "PPHO"}], "P": 3, "statusField": "estado_q_p1c2_4.1.3", "resultField": "peso_q_p1c2_4.1.3", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c3_4.1.3": {"rects": [[342.5, 293.75, 381.125, 303.25], [382.125, 293.75, 420.75, 303.25]], "page": 0, "col": 3, "code": "4.1.3", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.3", "frases": [{"texto": "As edifica\\u00e7\\u00f5es, as instala\\u00e7\\u00f5es, a canaliza\\u00e7\\u00e3o e os equipamentos da capta\\u00e7\\u00e3o devem ser submetidos \\u00e0 limpeza e, se for o caso, \\u00e0 desinfec\\u00e7\\u00e3o, de forma a minimizar os riscos de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "P": 3, "cat": "PPHO"}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e de desinfec\\u00e7\\u00e3o devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados e mantidos registros.", "P": 3, "cat": "PPHO"}], "P": 3, "statusField": "estado_q_p1c3_4.1.3", "resultField": "peso_q_p1c3_4.1.3", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p1c4_4.1.3": {"rects": [[425.75, 293.75, 464.75, 303.25], [465.75, 293.75, 504.75, 303.25]], "page": 0, "col": 4, "code": "4.1.3", "proc": "4.1", "allowNA": false, "classField": "classe_p1_4.1.3", "frases": [{"texto": "As edifica\\u00e7\\u00f5es, as instala\\u00e7\\u00f5es, a canaliza\\u00e7\\u00e3o e os equipamentos da capta\\u00e7\\u00e3o devem ser submetidos \\u00e0 limpeza e, se for o caso, \\u00e0 desinfec\\u00e7\\u00e3o, de forma a minimizar os riscos de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "P": 3, "cat": "PPHO"}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e de desinfec\\u00e7\\u00e3o devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados e mantidos registros.", "P": 3, "cat": "PPHO"}], "P": 3, "statusField": "estado_q_p1c4_4.1.3", "resultField": "peso_q_p1c4_4.1.3", "template": "Frases_4_1_1_S", "editorPrefix": "F_4_1_1_S_"}, "q_p2c1_4.2.2": {"rects": [[175.25, 119.0, 213.875, 128.5], [214.875, 119.0, 253.5, 128.5]], "page": 1, "col": 1, "code": "4.2.2", "proc": "4.2", "allowNA": false, "classField": "classe_p2_4.2.2", "frases": [{"texto": "A canaliza\\u00e7\\u00e3o deve atender ao \\u201cRegulamento T\\u00e9cnico - Crit\\u00e9rios Gerais e Classifica\\u00e7\\u00e3o de Materiais para Embalagens e Equipamentos em Contato com Alimentos\\u201d \(RES.", "cat": "PPRO", "P": 3}, {"texto": "RDC 91/01 ou sucessora\), outros regulamentos t\\u00e9cnicos espec\\u00edficos e suas altera\\u00e7\\u00f5es. As superf\\u00edcies da canaliza\\u00e7\\u00e3o que entram em contato com a \\u00e1gua mineral natural e com a \\u00e1gua natural devem ser lisas, \\u00edntegras, imperme\\u00e1veis, resistentes \\u00e0 corros\\u00e3o e de f\\u00e1cil higieniza\\u00e7\\u00e3o.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p2c1_4.2.2", "resultField": "peso_q_p2c1_4.2.2", "template": "Frases_4_2_2_S", "editorPrefix": "F_4_2_2_S_"}, "q_p2c2_4.2.2": {"rects": [[258.5, 119.0, 297.5, 128.5], [298.5, 119.0, 337.5, 128.5]], "page": 1, "col": 2, "code": "4.2.2", "proc": "4.2", "allowNA": false, "classField": "classe_p2_4.2.2", "frases": [{"texto": "A cana