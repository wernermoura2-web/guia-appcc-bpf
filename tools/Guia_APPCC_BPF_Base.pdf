d": "peso_q_p7c3_4.5.8", "template": "Frases_4_5_8_S", "editorPrefix": "F_4_5_8_S_"}, "q_p8c1_4.6.3": {"rects": [[175.25, 123.5, 213.875, 133.0], [214.875, 123.5, 253.5, 133.0]], "page": 7, "col": 1, "code": "4.6.3", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.3", "frases": [{"texto": "As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1g\\u00fce em maquin\\u00e1rio autom\\u00e1tico, utilizando-se solu\\u00e7\\u00e3o desinfetante, exceto as embalagens descart\\u00e1veis do tipo copo.", "cat": "PCC", "P": 3}], "P": 3, "statusField": "estado_q_p8c1_4.6.3", "resultField": "peso_q_p8c1_4.6.3"}, "q_p8c2_4.6.3": {"rects": [[258.5, 123.5, 297.5, 133.0], [298.5, 123.5, 337.5, 133.0]], "page": 7, "col": 2, "code": "4.6.3", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.3", "frases": [{"texto": "As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1g\\u00fce em maquin\\u00e1rio autom\\u00e1tico, utilizando-se solu\\u00e7\\u00e3o desinfetante, exceto as embalagens descart\\u00e1veis do tipo copo.", "cat": "PCC", "P": 3}], "P": 3, "statusField": "estado_q_p8c2_4.6.3", "resultField": "peso_q_p8c2_4.6.3"}, "q_p8c3_4.6.3": {"rects": [[342.5, 123.5, 381.125, 133.0], [382.125, 123.5, 420.75, 133.0]], "page": 7, "col": 3, "code": "4.6.3", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.3", "frases": [{"texto": "As embalagens de primeiro uso, quando n\\u00e3o fabricadas no pr\\u00f3prio estabelecimento industrial, devem ser submetidas ao enx\\u00e1g\\u00fce em maquin\\u00e1rio autom\\u00e1tico, utilizando-se solu\\u00e7\\u00e3o desinfetante, exceto as embalagens descart\\u00e1veis do tipo copo.", "cat": "PCC", "P": 3}], "P": 3, "statusField": "estado_q_p8c3_4.6.3", "resultField": "peso_q_p8c3_4.6.3"}, "q_p8c1_4.6.4": {"rects": [[175.25, 137.0, 213.875, 146.5], [214.875, 137.0, 253.5, 146.5]], "page": 7, "col": 1, "code": "4.6.4", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.4", "frases": [{"texto": "As embalagens retornadas para um novo ciclo de uso, antes da etapa de higieniza\\u00e7\\u00e3o autom\\u00e1tica, devem ser submetidas \\u00e0 pr\\u00e9-lavagem para a remo\\u00e7\\u00e3o do r\\u00f3tulo, dos res\\u00edduos da subst\\u00e2ncia adesiva e das sujidades das superf\\u00edcies interna e externa.", "cat": "PPHO", "P": 2}], "P": 2, "statusField": "estado_q_p8c1_4.6.4", "resultField": "peso_q_p8c1_4.6.4"}, "q_p8c2_4.6.4": {"rects": [[258.5, 137.0, 297.5, 146.5], [298.5, 137.0, 337.5, 146.5]], "page": 7, "col": 2, "code": "4.6.4", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.4", "frases": [{"texto": "As embalagens retornadas para um novo ciclo de uso, antes da etapa de higieniza\\u00e7\\u00e3o autom\\u00e1tica, devem ser submetidas \\u00e0 pr\\u00e9-lavagem para a remo\\u00e7\\u00e3o do r\\u00f3tulo, dos res\\u00edduos da subst\\u00e2ncia adesiva e das sujidades das superf\\u00edcies interna e externa.", "cat": "PPHO", "P": 2}], "P": 2, "statusField": "estado_q_p8c2_4.6.4", "resultField": "peso_q_p8c2_4.6.4"}, "q_p8c3_4.6.4": {"rects": [[342.5, 137.0, 381.125, 146.5], [382.125, 137.0, 420.75, 146.5]], "page": 7, "col": 3, "code": "4.6.4", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.4", "frases": [{"texto": "As embalagens retornadas para um novo ciclo de uso, antes da etapa de higieniza\\u00e7\\u00e3o autom\\u00e1tica, devem ser submetidas \\u00e0 pr\\u00e9-lavagem para a remo\\u00e7\\u00e3o do r\\u00f3tulo, dos res\\u00edduos da subst\\u00e2ncia adesiva e das sujidades das superf\\u00edcies interna e externa.", "cat": "PPHO", "P": 2}], "P": 2, "statusField": "estado_q_p8c3_4.6.4", "resultField": "peso_q_p8c3_4.6.4"}, "q_p8c1_4.6.5": {"rects": [[175.25, 150.5, 213.875, 160.0], [214.875, 150.5, 253.5, 160.0]], "page": 7, "col": 1, "code": "4.6.5", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.5", "frases": [{"texto": "As embalagens retornadas para um novo ciclo de uso devem ser submetidas \\u00e0 limpeza em maquin\\u00e1rio autom\\u00e1tico.", "cat": "PPRO", "P": 3}, {"texto": "As embalagens retornadas para um novo ciclo de uso devem ser submetidas \\u00e0 desinfec\\u00e7\\u00e3o em maquin\\u00e1rio autom\\u00e1tico, com comprova\\u00e7\\u00e3o da efic\\u00e1cia do processo.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c1_4.6.5", "resultField": "peso_q_p8c1_4.6.5", "template": "Frases_4_6_5_S", "editorPrefix": "F_4_6_5_S_"}, "q_p8c2_4.6.5": {"rects": [[258.5, 150.5, 297.5, 160.0], [298.5, 150.5, 337.5, 160.0]], "page": 7, "col": 2, "code": "4.6.5", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.5", "frases": [{"texto": "As embalagens retornadas para um novo ciclo de uso devem ser submetidas \\u00e0 limpeza em maquin\\u00e1rio autom\\u00e1tico.", "cat": "PPRO", "P": 3}, {"texto": "As embalagens retornadas para um novo ciclo de uso devem ser submetidas \\u00e0 desinfec\\u00e7\\u00e3o em maquin\\u00e1rio autom\\u00e1tico, com comprova\\u00e7\\u00e3o da efic\\u00e1cia do processo.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c2_4.6.5", "resultField": "peso_q_p8c2_4.6.5", "template": "Frases_4_6_5_S", "editorPrefix": "F_4_6_5_S_"}, "q_p8c3_4.6.5": {"rects": [[342.5, 150.5, 381.125, 160.0], [382.125, 150.5, 420.75, 160.0]], "page": 7, "col": 3, "code": "4.6.5", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.5", "frases": [{"texto": "As embalagens retornadas para um novo ciclo de uso devem ser submetidas \\u00e0 limpeza em maquin\\u00e1rio autom\\u00e1tico.", "cat": "PPRO", "P": 3}, {"texto": "As embalagens retornadas para um novo ciclo de uso devem ser submetidas \\u00e0 desinfec\\u00e7\\u00e3o em maquin\\u00e1rio autom\\u00e1tico, com comprova\\u00e7\\u00e3o da efic\\u00e1cia do processo.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c3_4.6.5", "resultField": "peso_q_p8c3_4.6.5", "template": "Frases_4_6_5_S", "editorPrefix": "F_4_6_5_S_"}, "q_p8c1_4.6.6": {"rects": [[175.25, 164.0, 213.875, 173.5], [214.875, 164.0, 253.5, 173.5]], "page": 7, "col": 1, "code": "4.6.6", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.6", "frases": [{"texto": "O enx\\u00e1g\\u00fce das embalagens retornadas para um novo ciclo de uso deve garantir a elimina\\u00e7\\u00e3o dos res\\u00edduos dos produtos qu\\u00edmicos utilizados na higieniza\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "A aus\\u00eancia desses res\\u00edduos deve ser comprovada por testes indicadores.", "cat": "PCC", "P": 3}], "P": 4, "statusField": "estado_q_p8c1_4.6.6", "resultField": "peso_q_p8c1_4.6.6", "template": "Frases_4_6_6_S", "editorPrefix": "F_4_6_6_S_"}, "q_p8c2_4.6.6": {"rects": [[258.5, 164.0, 297.5, 173.5], [298.5, 164.0, 337.5, 173.5]], "page": 7, "col": 2, "code": "4.6.6", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.6", "frases": [{"texto": "O enx\\u00e1g\\u00fce das embalagens retornadas para um novo ciclo de uso deve garantir a elimina\\u00e7\\u00e3o dos res\\u00edduos dos produtos qu\\u00edmicos utilizados na higieniza\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "A aus\\u00eancia desses res\\u00edduos deve ser comprovada por testes indicadores.", "cat": "PCC", "P": 3}], "P": 4, "statusField": "estado_q_p8c2_4.6.6", "resultField": "peso_q_p8c2_4.6.6", "template": "Frases_4_6_6_S", "editorPrefix": "F_4_6_6_S_"}, "q_p8c3_4.6.6": {"rects": [[342.5, 164.0, 381.125, 173.5], [382.125, 164.0, 420.75, 173.5]], "page": 7, "col": 3, "code": "4.6.6", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.6", "frases": [{"texto": "O enx\\u00e1g\\u00fce das embalagens retornadas para um novo ciclo de uso deve garantir a elimina\\u00e7\\u00e3o dos res\\u00edduos dos produtos qu\\u00edmicos utilizados na higieniza\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "A aus\\u00eancia desses res\\u00edduos deve ser comprovada por testes indicadores.", "cat": "PCC", "P": 3}], "P": 4, "statusField": "estado_q_p8c3_4.6.6", "resultField": "peso_q_p8c3_4.6.6", "template": "Frases_4_6_6_S", "editorPrefix": "F_4_6_6_S_"}, "q_p8c1_4.6.7": {"rects": [[175.25, 177.5, 213.875, 187.0], [214.875, 177.5, 253.5, 187.0]], "page": 7, "col": 1, "code": "4.6.7", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.7", "frases": [{"texto": "O enx\\u00e1g\\u00fce final das embalagens retornadas para um novo ciclo de uso e daquelas de primeiro uso deve ser feito com a \\u00e1gua mineral natural ou com a \\u00e1gua natural a ser envasada, exceto as embalagens descart\\u00e1veis do tipo copo.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c1_4.6.7", "resultField": "peso_q_p8c1_4.6.7"}, "q_p8c2_4.6.7": {"rects": [[258.5, 177.5, 297.5, 187.0], [298.5, 177.5, 337.5, 187.0]], "page": 7, "col": 2, "code": "4.6.7", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.7", "frases": [{"texto": "O enx\\u00e1g\\u00fce final das embalagens retornadas para um novo ciclo de uso e daquelas de primeiro uso deve ser feito com a \\u00e1gua mineral natural ou com a \\u00e1gua natural a ser envasada, exceto as embalagens descart\\u00e1veis do tipo copo.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c2_4.6.7", "resultField": "peso_q_p8c2_4.6.7"}, "q_p8c3_4.6.7": {"rects": [[342.5, 177.5, 381.125, 187.0], [382.125, 177.5, 420.75, 187.0]], "page": 7, "col": 3, "code": "4.6.7", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.7", "frases": [{"texto": "O enx\\u00e1g\\u00fce final das embalagens retornadas para um novo ciclo de uso e daquelas de primeiro uso deve ser feito com a \\u00e1gua mineral natural ou com a \\u00e1gua natural a ser envasada, exceto as embalagens descart\\u00e1veis do tipo copo.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c3_4.6.7", "resultField": "peso_q_p8c3_4.6.7"}, "q_p8c4_4.6.8": {"rects": [[425.75, 191.0, 464.75, 200.5], [465.75, 191.0, 504.75, 200.5]], "page": 7, "col": 4, "code": "4.6.8", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.8", "frases": [{"texto": "As tampas das embalagens n\\u00e3o devem ser ve\\u00edculos de contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PCC", "P": 3}], "P": 3, "statusField": "estado_q_p8c4_4.6.8", "resultField": "peso_q_p8c4_4.6.8"}, "q_p8c1_4.6.9": {"rects": [[175.25, 204.5, 213.875, 214.0], [214.875, 204.5, 253.5, 214.0]], "page": 7, "col": 1, "code": "4.6.9", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.9", "frases": [{"texto": "A sa\\u00edda do equipamento de higieniza\\u00e7\\u00e3o das embalagens deve estar posicionada pr\\u00f3xima \\u00e0 sala de envase para evitar que as embalagens circulem em ambiente aberto. Quando n\\u00e3o for poss\\u00edvel, as esteiras devem ser protegidas por cobertura.", "cat": "PPRO", "P": 2}, {"texto": "O transporte das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser realizado imediatamente.", "cat": "PPRO", "P": 2}], "P": 2, "statusField": "estado_q_p8c1_4.6.9", "resultField": "peso_q_p8c1_4.6.9", "template": "Frases_4_6_9_S", "editorPrefix": "F_4_6_9_S_"}, "q_p8c2_4.6.9": {"rects": [[258.5, 204.5, 297.5, 214.0], [298.5, 204.5, 337.5, 214.0]], "page": 7, "col": 2, "code": "4.6.9", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.9", "frases": [{"texto": "A sa\\u00edda do equipamento de higieniza\\u00e7\\u00e3o das embalagens deve estar posicionada pr\\u00f3xima \\u00e0 sala de envase para evitar que as embalagens circulem em ambiente aberto. Quando n\\u00e3o for poss\\u00edvel, as esteiras devem ser protegidas por cobertura.", "cat": "PPRO", "P": 2}, {"texto": "O transporte das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser realizado imediatamente.", "cat": "PPRO", "P": 2}], "P": 2, "statusField": "estado_q_p8c2_4.6.9", "resultField": "peso_q_p8c2_4.6.9", "template": "Frases_4_6_9_S", "editorPrefix": "F_4_6_9_S_"}, "q_p8c3_4.6.9": {"rects": [[342.5, 204.5, 381.125, 214.0], [382.125, 204.5, 420.75, 214.0]], "page": 7, "col": 3, "code": "4.6.9", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.9", "frases": [{"texto": "A sa\\u00edda do equipamento de higieniza\\u00e7\\u00e3o das embalagens deve estar posicionada pr\\u00f3xima \\u00e0 sala de envase para evitar que as embalagens circulem em ambiente aberto. Quando n\\u00e3o for poss\\u00edvel, as esteiras devem ser protegidas por cobertura.", "cat": "PPRO", "P": 2}, {"texto": "O transporte das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser realizado imediatamente.", "cat": "PPRO", "P": 2}], "P": 2, "statusField": "estado_q_p8c3_4.6.9", "resultField": "peso_q_p8c3_4.6.9", "template": "Frases_4_6_9_S", "editorPrefix": "F_4_6_9_S_"}, "q_p8c1_4.6.10": {"rects": [[175.25, 218.0, 213.875, 227.5], [214.875, 218.0, 253.5, 227.5]], "page": 7, "col": 1, "code": "4.6.10", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.10", "frases": [{"texto": "A passagem das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser feita por meio de abertura destinada exclusivamente para este fim e dimensionada somente para permitir a passagem das embalagens.", "cat": "PPRO", "P": 3}, {"texto": "N\\u00e3o \\u00e9 permitido o transporte manual das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase. A abertura de passagem deve permanecer fechada durante a paralisa\\u00e7\\u00e3o do processo de envase.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c1_4.6.10", "resultField": "peso_q_p8c1_4.6.10", "template": "Frases_4_6_10_S", "editorPrefix": "F_4_6_10_S_"}, "q_p8c2_4.6.10": {"rects": [[258.5, 218.0, 297.5, 227.5], [298.5, 218.0, 337.5, 227.5]], "page": 7, "col": 2, "code": "4.6.10", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.10", "frases": [{"texto": "A passagem das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser feita por meio de abertura destinada exclusivamente para este fim e dimensionada somente para permitir a passagem das embalagens.", "cat": "PPRO", "P": 3}, {"texto": "N\\u00e3o \\u00e9 permitido o transporte manual das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase. A abertura de passagem deve permanecer fechada durante a paralisa\\u00e7\\u00e3o do processo de envase.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c2_4.6.10", "resultField": "peso_q_p8c2_4.6.10", "template": "Frases_4_6_10_S", "editorPrefix": "F_4_6_10_S_"}, "q_p8c3_4.6.10": {"rects": [[342.5, 218.0, 381.125, 227.5], [382.125, 218.0, 420.75, 227.5]], "page": 7, "col": 3, "code": "4.6.10", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.10", "frases": [{"texto": "A passagem das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase deve ser feita por meio de abertura destinada exclusivamente para este fim e dimensionada somente para permitir a passagem das embalagens.", "cat": "PPRO", "P": 3}, {"texto": "N\\u00e3o \\u00e9 permitido o transporte manual das embalagens da \\u00e1rea de higieniza\\u00e7\\u00e3o para a sala de envase. A abertura de passagem deve permanecer fechada durante a paralisa\\u00e7\\u00e3o do processo de envase.", "cat": "PPRO", "P": 3}], "P": 3, "statusField": "estado_q_p8c3_4.6.10", "resultField": "peso_q_p8c3_4.6.10", "template": "Frases_4_6_10_S", "editorPrefix": "F_4_6_10_S_"}, "q_p8c1_4.6.11": {"rects": [[175.25, 231.5, 213.875, 241.0], [214.875, 231.5, 253.5, 241.0]], "page": 7, "col": 1, "code": "4.6.11", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.11", "frases": [{"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem seguir procedimentos que assegurem condi\\u00e7\\u00f5es higi\\u00eanico-sanit\\u00e1rias satisfat\\u00f3rias.", "cat": "PPHO", "P": 4}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados.", "cat": "PPHO", "P": 4}], "P": 4, "statusField": "estado_q_p8c1_4.6.11", "resultField": "peso_q_p8c1_4.6.11", "template": "Frases_4_6_11_S", "editorPrefix": "F_4_6_11_S_"}, "q_p8c2_4.6.11": {"rects": [[258.5, 231.5, 297.5, 241.0], [298.5, 231.5, 337.5, 241.0]], "page": 7, "col": 2, "code": "4.6.11", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.11", "frases": [{"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem seguir procedimentos que assegurem condi\\u00e7\\u00f5es higi\\u00eanico-sanit\\u00e1rias satisfat\\u00f3rias.", "cat": "PPHO", "P": 4}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados.", "cat": "PPHO", "P": 4}], "P": 4, "statusField": "estado_q_p8c2_4.6.11", "resultField": "peso_q_p8c2_4.6.11", "template": "Frases_4_6_11_S", "editorPrefix": "F_4_6_11_S_"}, "q_p8c3_4.6.11": {"rects": [[342.5, 231.5, 381.125, 241.0], [382.125, 231.5, 420.75, 241.0]], "page": 7, "col": 3, "code": "4.6.11", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.11", "frases": [{"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem seguir procedimentos que assegurem condi\\u00e7\\u00f5es higi\\u00eanico-sanit\\u00e1rias satisfat\\u00f3rias.", "cat": "PPHO", "P": 4}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados.", "cat": "PPHO", "P": 4}], "P": 4, "statusField": "estado_q_p8c3_4.6.11", "resultField": "peso_q_p8c3_4.6.11", "template": "Frases_4_6_11_S", "editorPrefix": "F_4_6_11_S_"}, "q_p8c4_4.6.11": {"rects": [[425.75, 231.5, 464.75, 241.0], [465.75, 231.5, 504.75, 241.0]], "page": 7, "col": 4, "code": "4.6.11", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.11", "frases": [{"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem seguir procedimentos que assegurem condi\\u00e7\\u00f5es higi\\u00eanico-sanit\\u00e1rias satisfat\\u00f3rias.", "cat": "PPHO", "P": 4}, {"texto": "As opera\\u00e7\\u00f5es de limpeza e desinfec\\u00e7\\u00e3o das embalagens devem ser realizadas por funcion\\u00e1rios comprovadamente capacitados.", "cat": "PPHO", "P": 4}], "P": 4, "statusField": "estado_q_p8c4_4.6.11", "resultField": "peso_q_p8c4_4.6.11", "template": "Frases_4_6_11_S", "editorPrefix": "F_4_6_11_S_"}, "q_p8c1_4.6.12": {"rects": [[175.25, 245.0, 213.875, 254.5], [214.875, 245.0, 253.5, 254.5]], "page": 7, "col": 1, "code": "4.6.12", "proc": "4.6", "allowNA": false, "classField": "classe_p8_4.6.12", "frases": [{"texto": "Devem ser implementados Procedimentos Operacionais Padronizados-POP referentes \\u00e0s opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o das embalagens. Os POP devem conter informa\\u00e7\\u00f5es sobre: natureza da superf\\u00edcie a ser higienizada, m\\u00e9todos de higieniza\\u00e7\\u00e3o, princ\\u00edpios ativos utilizados e sua concentra\\u00e7\\u00e3o, tempo de contato dos agentes qu\\u00edmicos e ou f\\u00edsicos utilizados na opera\\u00e7\\u00e3o de higieniza\\u00e7\\u00e3o, temperatura e outras informa\\u00e7\\u00f5es que se fizerem necess\\u00e1rias.", "cat": "PPHO", "P": 4}, {"texto": "Os Procedimentos Operacionais Padronizados referentes \\u00e0s opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o das embalagens devem estar dispon\\u00edveis e atualizados.", "cat": "PPHO", "P": 4}], "P": 4, "statusField": "estado_q_p8c1_4.6.12", "resultField": "peso_q_p8c1_4.6.12", "template": "Frases_4_6_12_S", "editorPrefix": "F_4_6_12_S_"}, "q_p8c2_4.6.12": {"rects": [[258.5, 245.0, 297.5, 254.5], [298.5, 245.0, 337.5, 254.5]], "page": 7, "col": 2, "code": "4.6.12", "proc": "4.6", "allo