 mineral natural e da \\u00e1gua natural.", "cat": "PCC", "P": 2}], "P": 2, "statusField": "estado_q_p11c2_4.7.1", "resultField": "peso_q_p11c2_4.7.1", "template": "Frases_4_7_1_S", "editorPrefix": "F_4_7_1_S_"}, "q_p11c3_4.7.1": {"rects": [[342.5, 132.5, 381.125, 142.0], [382.125, 132.5, 420.75, 142.0]], "page": 10, "col": 3, "code": "4.7.1", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4.7.1", "frases": [{"texto": "O envase e o fechamento das embalagens devem ser realizados por equipamentos autom\\u00e1ticos.", "cat": "PCC", "P": 2}, {"texto": "O fechamento deve garantir a veda\\u00e7\\u00e3o das embalagens para evitar vazamentos e contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PCC", "P": 2}], "P": 2, "statusField": "estado_q_p11c3_4.7.1", "resultField": "peso_q_p11c3_4.7.1", "template": "Frases_4_7_1_S", "editorPrefix": "F_4_7_1_S_"}, "q_p11c4_4.7.1": {"rects": [[425.75, 132.5, 464.75, 142.0], [465.75, 132.5, 504.75, 142.0]], "page": 10, "col": 4, "code": "4.7.1", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4.7.1", "frases": [{"texto": "O envase e o fechamento das embalagens devem ser realizados por equipamentos autom\\u00e1ticos.", "cat": "PCC", "P": 2}, {"texto": "O fechamento deve garantir a veda\\u00e7\\u00e3o das embalagens para evitar vazamentos e contamina\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural.", "cat": "PCC", "P": 2}], "P": 2, "statusField": "estado_q_p11c4_4.7.1", "resultField": "peso_q_p11c4_4.7.1", "template": "Frases_4_7_1_S", "editorPrefix": "F_4_7_1_S_"}, "q_p11c1_4.7.2": {"rects": [[175.25, 146.0, 213.875, 155.5], [214.875, 146.0, 253.5, 155.5]], "page": 10, "col": 1, "code": "4.7.2", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4.7.2", "frases": [{"texto": "O piso, a parede, o teto e a porta da sala de envase devem possuir revestimento liso, de cor clara, imperme\\u00e1vel e lav\\u00e1vel. A porta deve ser equipada com dispositivo de fechamento autom\\u00e1tico, ajustada aos batentes e em adequado estado de conserva\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "A sala de envase deve ser mantida em adequado estado de higiene e de conserva\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}], "P": 4, "statusField": "estado_q_p11c1_4.7.2", "resultField": "peso_q_p11c1_4.7.2", "template": "Frases_4_7_2_S", "editorPrefix": "F_4_7_2_S_"}, "q_p11c2_4.7.2": {"rects": [[258.5, 146.0, 297.5, 155.5], [298.5, 146.0, 337.5, 155.5]], "page": 10, "col": 2, "code": "4.7.2", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4.7.2", "frases": [{"texto": "O piso, a parede, o teto e a porta da sala de envase devem possuir revestimento liso, de cor clara, imperme\\u00e1vel e lav\\u00e1vel. A porta deve ser equipada com dispositivo de fechamento autom\\u00e1tico, ajustada aos batentes e em adequado estado de conserva\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "A sala de envase deve ser mantida em adequado estado de higiene e de conserva\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}], "P": 4, "statusField": "estado_q_p11c2_4.7.2", "resultField": "peso_q_p11c2_4.7.2", "template": "Frases_4_7_2_S", "editorPrefix": "F_4_7_2_S_"}, "q_p11c3_4.7.2": {"rects": [[342.5, 146.0, 381.125, 155.5], [382.125, 146.0, 420.75, 155.5]], "page": 10, "col": 3, "code": "4.7.2", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4.7.2", "frases": [{"texto": "O piso, a parede, o teto e a porta da sala de envase devem possuir revestimento liso, de cor clara, imperme\\u00e1vel e lav\\u00e1vel. A porta deve ser equipada com dispositivo de fechamento autom\\u00e1tico, ajustada aos batentes e em adequado estado de conserva\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "A sala de envase deve ser mantida em adequado estado de higiene e de conserva\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}], "P": 4, "statusField": "estado_q_p11c3_4.7.2", "resultField": "peso_q_p11c3_4.7.2", "template": "Frases_4_7_2_S", "editorPrefix": "F_4_