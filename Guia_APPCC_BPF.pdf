nfunction marcarItem\(key,a\){var c=CFG.itens[key];if\(c.frases.length>1\)return;if\(a==='A'&&!c.allowNA\)return;var d=dados.call\(this\);if\(d.det&&d.det[key]&&c.frases.length>1\){abrirFrases.call\(this,key\);return;}var rs=registros.call\(this,key,d\);for\(var i=0;i<rs.length;i++\)rs[i].a=a;d.u[key]=rs;gravar.call\(this,d\);atualizarObservacoes.call\(this\);recalcularTudo.call\(this\);}\nfunction mudarAPPCC\(cf,novo\){if\(BUSY\)return;var d=dados.call\(this\),cat=novo||val.call\(this,cf\);if\(!CFG.pesos[cat]\)return;d.refs[cf]=cat;for\(var k in CFG.itens\)if\(CFG.itens[k].classField===cf\){var rs=registros.call\(this,k,d\);for\(var i=0;i<rs.length;i++\)rs[i].c=cat;d.u[k]=rs;}gravar.call\(this,d\);recalcularTudo.call\(this\);}\nfunction recuperarEditor\(\){if\(ACTIVE\)return true;try{var raw=val.call\(this,'editor_ativo'\);if\(!raw\)return false;var a=JSON.parse\(raw\);if\(!a||!CFG.itens[a.key]\)return false;ACTIVE=a;return true;}catch\(e\){return false;}}\nfunction editorF\(n\){if\(!ACTIVE\)recuperarEditor.call\(this\);return ACTIVE?this.getField\(ACTIVE.prefix+n\):null;}\nfunction preencherPontuacaoFrase\(i,cat,p\){var nc=CFG.pesos[cat],nums={};nums['ed_nc_'+i]=nc;nums['ed_p_'+i]=p;nums['ed_score_'+i]=nc*p;for\(var name in nums\){var f=editorF.call\(this,name\);if\(f\){if\(String\(f.valueAsString\)===''||Number\(f.valueAsString\)!==nums[name]\)f.value=nums[name];}}}\nfunction mostrarEditor\(\){if\(!ACTIVE\)recuperarEditor.call\(this\);if\(!ACTIVE||EDITOR_BUSY\)return;EDITOR_BUSY=true;try{var key=ACTIVE.key,c=CFG.itens[key],d=dados.call\(this\),rs=registros.call\(this,key,d\),f=editorF.call\(this,'ed_title'\);if\(f\)f.value='Item '+c.code+' - '+nomeUnidade.call\(this,c\);f=editorF.call\(this,'ed_context'\);if\(f\)f.value='NC: PPR=1; PPHO=2; PC=3; PPRO=4; PCC=5. P da frase: <20%=1; 20 a <40%=2; 40 a <60%=3; 60 a 75%=4; >75%=5. Pontua\347\343o=NC x P. N/A conforme item.';for\(var i=0;i<rs.length;i++\){\nif\(i>=rs.length\)continue;var r=rs[i],nc=CFG.pesos[r.c]||1;var