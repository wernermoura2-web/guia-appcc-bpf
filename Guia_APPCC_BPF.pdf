s n\\u00e3o forem atendidas, os insumos devem ser reprovados.","cat":"PCC","P":5},{"texto":"Os produtos saneantes devem estar regularizados no \\u00f3rg\\u00e3o competente.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p7c2_4.5.3","resultField":"peso_q_p7c2_4.5.3","template":"Frases_4_1_2_S","editorPrefix":"F_4_1_2_S_"},"q_p7c3_4.5.3":{"rects":[[342.5,119.0,381.125,128.5],[382.125,119.0,420.75,128.5]],"page":6,"col":3,"code":"4.5.3","proc":"4.5","allowNA":false,"classField":"classe_p7_4.5.3","frases":[{"texto":"Os insumos devem ser submetidos \\u00e0 inspe\\u00e7\\u00e3o no ato da recep\\u00e7\\u00e3o.","cat":"PPRO","P":5},{"texto":"Quando as especifica\\u00e7\\u00f5es previamente determinadas n\\u00e3o forem atendidas, os insumos devem ser reprovados.","cat":"PCC","P":5},{"texto":"Os produtos saneantes devem estar regularizados no \\u00f3rg\\u00e3o competente.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p7c3_4.5.3","resultField":"peso_q_p7c3_4.5.3","template":"Frases_4_1_2_S","editorPrefix":"F_4_1_2_S_"},"q_p7c4_4.5.3":{"rects":[[425.75,119.0,464.75,128.5],[465.75,119.0,504.75,128.5]],"page":6,"col":4,"code":"4.5.3","proc":"4.5","allowNA":false,"classField":"classe_p7_4.5.3","frases":[{"texto":"Os insumos devem ser submetidos \\u00e0 inspe\\u00e7\\u00e3o no ato da recep\\u00e7\\u00e3o.","cat":"PPRO","P":5},{"texto":"Quando as especifica\\u00e7\\u00f5es previamente determinadas n\\u00e3o forem atendidas, os insumos devem ser reprovados.","cat":"PCC","P":5},{"texto":"Os produtos saneantes devem estar regularizados no \\u00f3rg\\u00e3o competente.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p7c4_4.5.3","resultField":"peso_q_p7c4_4.5.3","template":"Frases_4_1_2_S","editorPrefix":"F_4_1_2_S_"},"q_p7c1_4.5.4":{"rects":[[175.25,132.5,200.6666717529297,142.0],[201.6666717529297,132.5,227.0833282470703,142.0],[228.0833282470703,132.5,253.5,142.0]],"page":6,"col":1,"code":"4.5.4","proc":"4.5","allowNA":true,"classField":"classe_p7_4.5.4","frases":[{"texto":"As embalagens pl\\u00e1sticas retorn\\u00e1veis recebidas para um novo ciclo de uso devem ser avaliadas individualmente quanto \\u00e0 apar\\u00eancia interna e externa, \\u00e0 presen\\u00e7a de res\\u00edduos e ao odor.","cat":"PCC","P":1},{"texto":"As embalagens pl\\u00e1sticas com amassamentos, rachaduras, ranhuras, remendos, deforma\\u00e7\\u00f5es internas e externas do gargalo, com altera\\u00e7\\u00f5es de odor e cor, dentre outras altera\\u00e7\\u00f5es que possam comprometer a qualidade higi\\u00eanico-sanit\\u00e1ria da \\u00e1gua mineral natural ou da \\u00e1gua natural devem ser reprovadas.","cat":"PCC","P":1}],"P":1,"statusField":"estado_q_p7c1_4.5.4","resultField":"peso_q_p7c1_4.5.4","template":"Frases_4_5_4_A","editorPrefix":"F_4_5_4_A_"},"q_p7c1_4.5.6":{"rects":[[175.25,146.0,200.6666717529297,155.5],[201.6666717529297,146.0,227.0833282470703,155.5],[228.0833282470703,146.0,253.5,155.5]],"page":6,"col":1,"code":"4.5.6","proc":"4.5","allowNA":true,"classField":"classe_p7_4.5.6","frases":[{"texto":"Os insumos reprovados na recep\\u00e7\\u00e3o devem ser imediatamente devolvidos ao fornecedor ou distribuidor e, quando n\\u00e3o for poss\\u00edvel, devem ser devidamente identificados e armazenados separadamente at\\u00e9 o seu destino final.","cat":"PPRO","P":4},{"texto":"O destino final dos insumos reprovados deve ser registrado em documento datado e assinado pelo funcion\\u00e1rio respons\\u00e1vel.","cat":"PPRO","P":4}],"P":4,"statusField":"estado_q_p7c1_4.5.6","resultField":"peso_q_p7c1_4.5.6","template":"Frases_4_5_6_A","editorPrefix":"F_4_5_6_A_"},"q_p7c2_4.5.6":{"rects":[[258.5,146.0,297.5,155.5],[298.5,146.0,337.5,155.5]],"page":6,"col":2,"code":"4.5.6","proc":"4.5","allowNA":false,"classField":"classe_p7_4.5.6","frases":[{"texto":"Os insumos reprovados na recep\\u00e7\\u00e3o devem ser imediatamente devolvidos ao fornecedor ou distribuidor e, quando n\\u00e3o for poss\\u00edvel, devem ser devidamente identificados e armazenados separadamen