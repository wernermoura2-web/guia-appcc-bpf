if\(ncs.indexOf\(nc\)<0\)ncs.push\(nc\);if\(ps.indexOf\(p\)<0\)ps.push\(p\);possible+=nc*p;}\n   put.call\(this,'criticidade_'+cf,ncs.join\('/'\)\);put.call\(this,'prob_'+cf,ps.join\('/'\)\);\n   var suffix=cf.substring\(7\);put.call\(this,'pontuacao_'+suffix,possible\);\n   for\(var i=0;i<list.length;i++\){var z=list[i].z;if\(!z.active\)continue;active=true;num+=z.num;if\(!z.complete\)pending=true;else ans.push\(z.a\);}\n   put.call\(this,'pont_result_'+suffix,active?num:''\);\n   put.call\(this,'res_'+suffix,pending?'Pendente':ans.indexOf\('N'\)>=0?'N\343o':ans.indexOf\('S'\)>=0?'Sim':ans.length?'N/A':''\);\n  }\n  for\(var g in CFG.grupos\){\n   var keys=CFG.grupos[g],act=false,pend=false,den=0,num=0,cfg=CFG.itens[keys[0]];\n   for\(var i=0;i<keys.length;i++\){var z=items[keys[i]];if\(z.active\)act=true;if\(!z.complete\)pend=true;den+=z.itemDen;num+=z.itemNum;}\n   var q={active:act,pending:act&&pend,num:num,den:den,pct:act&&!pend&&den?100*num/den:null,na:act&&!pend&&!den,proc:cfg.proc,page:cfg.page,col:cfg.col};gs[g]=q;\n   var sim=simularAPPCC.call\(this,keys,d\);put.call\(this,'pct_'+g,\(q.pct!==null?pctTexto\(q.pct\):q.na?'N/A':''\)+'\\r'+simulacaoTexto\(sim,true\)\);put.call\(this,'risk_'+g,\(q.pending?'Pendente':q.na?'N/A':q.pct!==null?nomeRisco\(risco\(cfg.proc,q.pct\)\):''\)+'\\r'+simulacaoTexto\(sim,false\)\);\n   if\(!byPage[cfg.page]\)byPage[cfg.page]=[];byPage[cfg.page].push\(q\);if\(!byProc[cfg.proc]\)byProc[cfg.proc]=[];byProc[cfg.proc].push\(q\);\n  }\n  for\(var page in byPage\){var pp=Number\(page\)+1,q=consolidar\(byPage[page]\),proc=byPage[page][0].proc;var simkeys=[];for\(var sk in CFG.itens\)if\(CFG.itens[sk].page===Number\(page\)\)simkeys.push\(sk\);var sim=simularAPPCC.call\(this,simkeys,d\);put.call\(this,'pct_resultado_p'+pp,\(q.pct!==null?pctTexto\(q.pct\):q.na?'N/A':''\)+'\\r'+simulacaoTexto\(sim,true\)\);put.call\(this,'risco_resultado_p'+pp,\(q.pending?'Pendente':q.na?'N/A':q.pct!==null?nomeRisco\(risco\(proc,q.pct\)\):''\)+'\\r'+simu