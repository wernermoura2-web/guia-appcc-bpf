atusField": "estado_q_p2c4_4.2.7", "resultField": "peso_q_p2c4_4.2.7", "template": "Frases_4_2_7_S", "editorPrefix": "F_4_2_7_S_"}, "q_p2c1_4.2.8": {"rects": [[175.25, 146.0, 213.875, 155.5], [214.875, 146.0, 253.5, 155.5]], "page": 1, "col": 1, "code": "4.2.8", "proc": "4.2", "allowNA": false, "classField": "classe_p2_4.2.8", "frases": [{"texto": "A higieniza\\u00e7\\u00e3o deve contemplar, quando aplic\\u00e1vel, o desmonte da canaliza\\u00e7\\u00e3o e prever a freq\\u00fc\\u00eancia de realiza\\u00e7\\u00e3o desta opera\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "Caso seja constatada a presen\\u00e7a de incrusta\\u00e7\\u00f5es e de outras altera\\u00e7\\u00f5es que possam comprometer a qualidade higi\\u00eanico-sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural, devem ser revistas as opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o e adotadas as medidas corretivas necess\\u00e1rias.", "cat": "PPRO", "P": 4}], "P": 4, "statusField": "estado_q_p2c1_4.2.8", "resultField": "peso_q_p2c1_4.2.8", "template": "Frases_4_2_8_S", "editorPrefix": "F_4_2_8_S_"}, "q_p2c2_4.2.8": {"rects": [[258.5, 146.0, 297.5, 155.5], [298.5, 146.0, 337.5, 155.5]], "page": 1, "col": 2, "code": "4.2.8", "proc": "4.2", "allowNA": false, "classField": "classe_p2_4.2.8", "frases": [{"texto": "A higieniza\\u00e7\\u00e3o deve contemplar, quando aplic\\u00e1vel, o desmonte da canaliza\\u00e7\\u00e3o e prever a freq\\u00fc\\u00eancia de realiza\\u00e7\\u00e3o desta opera\\u00e7\\u00e3o.", "cat": "PPRO", "P": 4}, {"texto": "Caso seja constatada a presen\\u00e7a de incrusta\\u00e7\\u00f5es e de outras altera\\u00e7\\u00f5es que possam comprometer a qualidade higi\\u00eanico-sanit\\u00e1ria da \\u00e1gua mineral natural e da \\u00e1gua natural, devem ser revistas as opera\\u00e7\\u00f5es de higieniza\\u00e7\\u00e3o e adotadas as medidas corretivas necess\\u00e1rias.", "cat": "PPRO", "P": 4}], "P": 4, "statusField": "estado_q_p2c2_4.2.8", "resultField": "peso_q_p2c2_4.2.8", 