\054\042col\042\0724\054\042code\042\072\0424\0567\0568\042\054\042proc\042\072\0424\0567\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p11\1374\0567\0568\042\054\042frases\042\072\133\173\042texto\042\072\042A sala de envase e os equipamentos devem ser higienizados quantas vezes forem necess\134u00e1rias e imediatamente ap\134u00f3s o t\134u00e9rmino do trabalho\056\042\054\042cat\042\072\042PCC\042\054\042P\042\0723\054\042orientacao\042\072\042Conferir POP\054 limites validados e limpeza de bicos\054 veda\134u00e7\134u00f5es e reservat\134u00f3rio pulm\134u00e3o\073 verificar microbiologia ambiental\054 de superf\134u00edcies e \134u00e1gua\054 ATP nos pontos aplic\134u00e1veis e libera\134u00e7\134u00e3o documentada da sala e dos equipamentos\073 em falha\054 bloquear\054 corrigir e repetir a avalia\134u00e7\134u00e3o \050L1\051\056\042\054\042consideracao\042\072\042Higieniza\134u00e7\134u00e3o do ambiente e das superf\134u00edcies de contato\056\042\054\042providencia\042\072\042Comprovar higieniza\134u00e7\134u00e3o da sala e dos equipamentos e libera\134u00e7\134u00e3o por microbiologia e\057ou ATP nos pontos aplic\134u00e1veis\054 conforme protocolo validado\056\042\175\054\173\042texto\042\072\042Quando aplic\134u00e1vel\054 a higieniza\134u00e7\134u00e3o deve contemplar o desmonte dos equipamentos na freq\134u00fc\134u00eancia definida pelo estabelecimento industrial\056\042\054\042cat\042\072\042PPRO\042\054\042P\042\0723\054\042orientacao\042\072\042Verificar desmonte\054 frequ\134u00eancia\054 acesso a bicos\054 veda\134u00e7\134u00f5es e demais pontos cr\134u00edticos\054 registros e remontagem\073 conferir libera\134u00e7\134u00e3o por microbiologia e\057ou ATP segundo o PCC 4\0567\0568 F1 \050L1\051\056\042\054\042consideracao\042\072\042Desmonte permite higieniza\134u00e7\134u00e3o dos pontos cr\134u00edticos\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0723\054\042statusField\042\072\042estado\137q\137p11c4\1374\0567\0568\042\054\042resultField\042\072\042peso\137q\137p11c4\1374\0567\0568\042\054\042template\042\072\042Frases\1374\1377\1378\137S\042\054\042editorPrefix\042\072\042F\1374\1377\1378\137S\137\042\175\054\042q\137p12c1\1374\05610\0561\042\072\173\042rects\042\072\133\133528\05625\054106\05675\054577\05625\054120\05675\135\054\133528\05625\054122\05675\054577\05625\054136\05675\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05610\0561\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p12\1374\05610\0561\042\054\042frases\042\072\133\173\042texto\042\072\042O estabelecimento industrial deve implementar e documentar o controle de qualidade da \134u00e1gua mineral natural\054 da \134u00e1gua natural\054 das embalagens e\054 quando utilizado\054 do di\134u00f3xido de carbono\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0724\054\042orientacao\042\072\042Conferir programa de controle de qualidade documentado e implantado para \134u00e1gua\054 embalagens e CO2 quando utilizado\054 com respons\134u00e1veis e registros\056\042\054\042consideracao\042\072\042Organiza\134u00e7\134u00e3o e documenta\134u00e7\134u00e3o do sistema de CQ\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0724\054\042statusField\042\072\042estado\137q\137p12c1\1374\05610\0561\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05610\0561\042\175\054\042q\137p12c1\1374\05610\0562\042\072\173\042rects\042\072\133\133528\05625\054166\05675\054577\05625\054180\05675\135\054\133528\05625\054182\05675\054577\05625\054196\05675\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05610\0562\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p12\1374\05610\0562\042\054\042frases\042\072\133\173\042texto\042\072\042As an\134u00e1lises laboratoriais para o controle e o monitoramento da qualidade da \134u00e1gua mineral natural e da \134u00e1gua natural devem ser realizadas em laborat\134u00f3rio pr\134u00f3prio ou terceirizado\042\054\042cat\042\072\042PPR\042\054\042P\042\0724\054\042orientacao\042\072\042Verificar laborat\134u00f3rio pr\134u00f3prio ou contrato vigente com terceirizado\054 escopo\054 capacidade e rastreabilidade das an\134u00e1lises e dos resultados\056\042\054\042consideracao\042\072\042Estrutura e contrata\134u00e7\134u00e3o de suporte anal\134u00edtico\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0724\054\042statusField\042\072\042estado\137q\137p12c1\1374\05610\0562\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05610\0562\042\175\054\042q\137p12c1\1374\05610\0563\042\072\173\042rects\042\072\133\133528\05625\054227\0565\054577\05625\054241\0565\135\054\133528\05625\054243\0565\054577\05625\054257\0565\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05610\0563\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p12\1374\05610\0563\042\054\042frases\042\072\133\173\042texto\042\072\042As an\134u00e1lises microbiol\134u00f3gicas e de contaminantes qu\134u00edmicos da \134u00e1gua mineral natural e da \134u00e1gua natural devem atender ao disposto em legisla\134u00e7\134u00e3o especifica\056\042\054\042cat\042\072\042PC\042\054\042P\042\0725\054\042orientacao\042\072\042Conferir laudos microbiol\134u00f3gicos e de contaminantes qu\134u00edmicos\054 identifica\134u00e7\134u00e3o das amostras\054 m\134u00e9todos e atendimento aos padr\134u00f5es aplic\134u00e1veis\073 verificar investiga\134u00e7\134u00e3o de resultados insatisfat\134u00f3rios\056\042\054\042consideracao\042\072\042Ensaios verificam atendimento aos padr\134u00f5es\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0725\054\042statusField\042\072\042estado\137q\137p12c1\1374\05610\0563\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05610\0563\042\175\054\042q\137p12c1\1374\05610\0564\042\072\173\042rects\042\072\133\133528\05625\054288\05625\054577\05625\054302\05625\135\054\133528\05625\054304\05625\054577\05625\054318\05625\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05610\0564\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p12\1374\05610\0564\042\054\042frases\042\072\133\173\042texto\042\072\042O estabelecimento industrial deve estabelecer plano de amostragem\054 especificando o n\134u00famero de amostras\054 o local de coleta\054 os par\134u00e2metros anal\134u00edticos e a frequ\134u00eancia a ser realizada\054 envolvendo as diversas etapas da industrializa\134u00e7\134u00e3o\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0724\054\042orientacao\042\072\042Conferir plano com pontos\054 n\134u00famero de amostras\054 par\134u00e2metros\054 m\134u00e9todos e frequ\134u00eancias\073 incluir verifica\134u00e7\134u00f5es p\134u00f3s\055higieniza\134u00e7\134u00e3o\054 crit\134u00e9rios de libera\134u00e7\134u00e3o\054 testes de ATP aplic\134u00e1veis e controle microbiol\134u00f3gico do ar de sopro e das embalagens\056\042\054\042consideracao\042\072\042Planejamento do programa de amostragem\056\042\054\042providencia\042\072\042\042\175\054\173\042texto\042\072\042O estabelecimento industrial deve executar o plano de amostragem e definir os limites de aceita\134u00e7\134u00e3o a serem determinados nas amostras coletadas\054 segundo o plano estabelecido\056\042\054\042cat\042\072\042PCC\042\054\042P\042\0725\054\042orientacao\042\072\042Comparar coletas\054 placas ou meios preparados e ensaios com o plano\073 verificar an\134u00e1lise dos lotes\054 limites de aceita\134u00e7\134u00e3o\054 rastreabilidade e reten\134u00e7\134u00e3o at\134u00e9 resultados conformes\073 conferir autoriza\134u00e7\134u00e3o de libera\134u00e7\134u00e3o\054 bloqueio\054 investiga\134u00e7\134u00e3o e destino dos lotes reprovados \050L3\051\056\042\054\042consideracao\042\072\042PCC adotado\072 decis\134u00e3o de libera\134u00e7\134u00e3o dos lotes\056\042\054\042providencia\042\072\042Comprovar execu\134u00e7\134u00e3o do plano\054 reten\134u00e7\134u00e3o e libera\134u00e7\134u00e3o dos lotes somente ap\134u00f3s resultados conformes\073 registrar investiga\134u00e7\134u00e3o e destino dos reprovados\056\042\175\135\054\042P\042\0725\054\042statusField\042\072\042estado\137q\137p12c1\1374\05610\0564\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05610\0564\042\054\042template\042\072\042Frases\1374\13710\1374\137S\042\054\042editorPrefix\042\072\042F\1374\13710\1374\137S\137\042\175\054\042q\137p12c1\1374\05610\0565\042\072\173\042rects\042\072\133\133528\05625\054348\05625\054577\05625\054362\05625\135\054\133528\05625\054364\05625\054577\05625\054378\05625\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05610\0565\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p12\1374\05610\0565\042\054\042frases\042\072\133\173\042texto\042\072\042A \134u00e1gua mineral natural ou a \134u00e1gua natural envasada deve apresentar composi\134u00e7\134u00e3o equivalente \134u00e0 respectiva \134u00e1gua emergente da fonte ou po\134u00e7o\054 conforme especificada nas an\134u00e1lises laboratoriais efetuadas pelo \134u00f3rg\134u00e3o competente do Minist\134u00e9rio das Minas e Energia\056\042\054\042cat\042\072\042PC\042\054\042P\042\0725\054\042orientacao\042\072\042Comparar composi\134u00e7\134u00e3o da \134u00e1gua envasada com a da respectiva fonte ou po\134u00e7o e com os laudos de refer\134u00eancia\073 conferir identifica\134u00e7\134u00e3o e investiga\134u00e7\134u00e3o das diferen\134u00e7as\056\042\054\042consideracao\042\072\042Verifica\134u00e7\134u00e3o da identidade e composi\134u00e7\134u00e3o da \134u00e1gua\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0725\054\042statusField\042\072\042estado\137q\137p12c1\1374\05610\0565\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05610\0565\042\175\054\042q\137p12c1\1374\05610\0566\042\072\173\042rects\042\072\133\133528\05625\054409\0560\054577\05625\054423\0560\135\054\133528\05625\054425\0560\054577\05625\054439\0560\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05610\0566\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p12\1374\05610\0566\042\054\042frases\042\072\133\173\042texto\042\072\042O estabelecimento industrial deve adotar as medidas corretivas em caso de desvios dos par\134u00e2metros estabelecidos\056\042\054\042cat\042\072\042PC\042\054\042P\042\0725\054\042orientacao\042\072\042Conferir investiga\134u00e7\134u00e3o\054 bloqueio dos lotes afetados\054 destino do produto e a\134u00e7\134u00f5es corretivas\073 verificar efic\134u00e1cia e crit\134u00e9rios de retomada ou libera\134u00e7\134u00e3o\056\042\054\042consideracao\042\072\042Gest\134u00e3o de desvios e decis\134u00e3o sobre o produto\056\042\054\042providencia\042\072\042\042\175\054\173\042texto\042\072\042Essas medidas devem estar documentadas\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0725\054\042orientacao\042\072\042Conferir registros dos desvios\054 causas\054 medidas adotadas\054 respons\134u00e1veis\054 prazos\054 destino dos lotes e verifica\134u00e7\134u00e3o da efic\134u00e1cia\056\042\054\042consideracao\042\072\042Documenta\134u00e7\134u00e3o das medidas adotadas\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0725\054\042statusField\042\072\042estado\137q\137p12c1\1374\05610\0566\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05610\0566\042\054\042template\042\072\042Frases\1374\13710\1376\137S\042\054\042editorPrefix\042\072\042F\1374\13710\1376\137S\137\042\175\054\042q\137p12c1\1374\05612\0566\042\072\173\042rects\042\072\133\133528\05625\054469\0560\054577\05625\054483\0560\135\054\133528\05625\054485\0560\054577\05625\054499\0560\135\054\133528\05625\054501\0560\054577\05625\054515\0560\135\135\054\042page\042\07211\054\042col\042\0721\054\042code\042\072\0424\05612\0566\042\054\042proc\042\072\0424\05610\042\054\042allowNA\042\072true\054\042classField\042\072\042classe\137p12\1374\05612\0566\042\054\042frases\042\072\133\173\042texto\042\072\042O estabelecimento industrial deve dispor de documenta\134u00e7\134u00e3o que comprove a qualidade de cada carga do di\134u00f3xido de carbono\056\042\054\042cat\042\072\042PC\042\054\042P\042\0722\054\042orientacao\042\072\042Conferir certificado de qualidade de cada carga de CO2\054 especifica\134u00e7\134u00f5es\054 identifica\134u00e7\134u00e3o do fornecedor e v\134u00ednculo com recebimento\054 tanque e lotes produzidos\056\042\054\042consideracao\042\072\042Libera\134u00e7\134u00e3o documental de cada carga de CO2\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0722\054\042statusField\042\072\042estado\137q\137p12c1\1374\05612\0566\042\054\042resultField\042\072\042peso\137q\137p12c1\1374\05612\0566\042\175\054\042q\137p13c1\1374\05611\0561\042\072\173\042rects\042\072\133\133528\05625\054106\05675\054577\05625\054120\05675\135\054\133528\05625\054122\05675\054577\05625\054136\05675\135\135\054\042page\042\07212\054\042col\042\0721\054\042code\042\072\0424\05611\0561\042\054\042proc\042\072\0424\05611\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p13\1374\05611\0561\042\054\042frases\042\072\133\173\042texto\042\072\042Os manipuladores de alimentos devem ser supervisionados\054 sendo capacitados periodicamente em\072 higiene pessoal\054 manipula\134u00e7\134u00e3o higi\134u00eanica dos alimentos e em doen\134u00e7as transmitidas por alimentos\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0722\054\042orientacao\042\072\042Conferir supervis\134u00e3o e capacita\134u00e7\134u00e3o peri\134u00f3dica em higiene pessoal\054 manipula\134u00e7\134u00e3o higi\134u00eanica e doen\134u00e7as transmitidas por alimentos\073 observar aplica\134u00e7\134u00e3o na rotina\056\042\054\042consideracao\042\072\042Supervis\134u00e3o e capacita\134u00e7\134u00e3o de pessoal\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0722\054\042statusField\042\072\042estado\137q\137p13c1\1374\05611\0561\042\054\042resultField\042\072\042peso\137q\137p13c1\1374\05611\0561\042\175\054\042q\137p13c1\1374\05611\0562\042\072\173\042rects\042\072\133\133528\05625\054223\05675\054577\05625\054237\05675\135\054\133528\05625\054239\05675\054577\05625\054253\05675\135\135\054\042page\042\07212\054\042col\042\0721\054\042code\042\072\0424\05611\0562\042\054\042proc\042\072\0424\05611\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p13\1374\05611\0562\042\054\042frases\042\072\133\173\042texto\042\072\042A responsabilidade pela industrializa\134u00e7\134u00e3o da \134u00e1gua mineral natural e da \134u00e1gua natural deve ser exercida pelo respons\134u00e1vel t\134u00e9cnico\054 respons\134u00e1vel legal ou propriet\134u00e1rio do estabelecimento industrial\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0722\054\042orientacao\042\072\042Conferir identifica\134u00e7\134u00e3o e designa\134u00e7\134u00e3o do respons\134u00e1vel pela industrializa\134u00e7\134u00e3o\054 atribui\134u00e7\134u00f5es e exerc\134u00edcio efetivo da fun\134u00e7\134u00e3o no estabelecimento\056\042\054\042consideracao\042\072\042Defini\134u00e7\134u00e3o de responsabilidade organizacional\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0722\054\042statusField\042\072\042estado\137q\137p13c1\1374\05611\0562\042\054\042resultField\042\072\042peso\137q\137p13c1\1374\05611\0562\042\175\054\042q\137p13c1\1374\05611\0563\042\072\173\042rects\042\072\133\133528\05625\054340\05675\054577\05625\054354\05675\135\054\133528\05625\054356\05675\054577\05625\054370\05675\135\135\054\042page\042\07212\054\042col\042\0721\054\042code\042\072\0424\05611\0563\042\054\042proc\042\072\0424\05611\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p13\1374\05611\0563\042\054\042frases\042\072\133\173\042texto\042\072\042A responsabilidade deve ser exercida por funcion\134u00e1rio que tenha realizado curso de capacita\134u00e7\134u00e3o\054 com carga hor\134u00e1ria m\134u00ednima de 40 \050quarenta\051 horas\054 abordando os seguintes temas\072a\051 Microbiologia de Alimentos\073b\051 Industrializa\134u00e7\134u00e3o da \134u00e1gua mineral natural e da \134u00e1gua natural\073c\051 Boas Pr\134u00e1ticas\073d\051 Sistema de An\134u00e1lise de Perigos e Pontos Cr\134u00edticos de Controle \055 APPCC\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0723\054\042orientacao\042\072\042Conferir capacita\134u00e7\134u00e3o do respons\134u00e1vel\054 carga hor\134u00e1ria m\134u00ednima de 40 horas e conte\134u00fados de microbiologia\054 industrializa\134u00e7\134u00e3o de \134u00e1guas\054 BPF e APPCC previstos na frase\056\042\054\042consideracao\042\072\042Qualifica\134u00e7\134u00e3o do respons\134u00e1vel pela industrializa\134u00e7\134u00e3o\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0723\054\042statusField\042\072\042estado\137q\137p13c1\1374\05611\0563\042\054\042resultField\042\072\042peso\137q\137p13c1\1374\05611\0563\042\175\054\042q\137p13c1\1374\05611\0564\042\072\173\042rects\042\072\133\133528\05625\054457\05675\054577\05625\054471\05675\135\054\133528\05625\054473\05675\054577\05625\054487\05675\135\135\054\042page\042\07212\054\042col\042\0721\054\042code\042\072\0424\05611\0564\042\054\042proc\042\072\0424\05611\042\054\042allowNA\042\072false\054\042classField\042\072\042classe\137p13\1374\05611\0564\042\054\042frases\042\072\133\173\042texto\042\072\042O estabelecimento industrial deve dispor do certificado de capacita\134u00e7\134u00e3o dos manipuladores e do certificado do respons\134u00e1vel pela industrializa\134u00e7\134u00e3o\054 devidamente datado\054 contendo a carga hor\134u00e1ria e o conte\134u00fado program\134u00e1tico dos cursos\056\042\054\042cat\042\072\042PPR\042\054\042P\042\0723\054\042orientacao\042\072\042Conferir certificados dos manipuladores e do respons\134u00e1vel pela industrializa\134u00e7\134u00e3o\054 identifica\134u00e7\134u00e3o\054 datas\054 carga hor\134u00e1ria e conte\134u00fado program\134u00e1tico\056\042\054\042consideracao\042\072\042Comprova\134u00e7\134u00e3o documental da capacita\134u00e7\134u00e3o\056\042\054\042providencia\042\072\042\042\175\135\054\042P\042\0723\054\042statusField\042\072\042estado\137q\137p13c1\1374\05611\0564\042\054\042resultField\042\072\042peso\137q\137p13c1\1374\05611\0564\042\175\175\054\042grupos\042\072\173\042p1c1\042\072\133\042q\137p1c1\1374\0561\0561\042\054\042q\137p1c1\1374\0561\0562\042\054\042q\137p1c1\1374\0561\0563\042\135\054\042p1c2\042\072\133\042q\137p1c2\1374\0561\0561\042\054\042q\137p1c2\1374\0561\0562\042\054\042q\137p1c2\1374\0561\0563\042\135\054\042p1c3\042\072\133\042q\137p1c3\1374\0561\0561\042\054\042q\137p1c3\1374\0561\0562\042\054\042q\137p1c3\1374\0561\0563\042\135\054\042p1c4\042\072\133\042q\137p1c4\1374\0561\0561\042\054\042q\137p1c4\1374\0561\0562\042\054\042q\137p1c4\1374\0561\0563\042\135\054\042p2c1\042\072\133\042q\137p2c1\1374\0562\0562\042\054\042q\137p2c1\1374\0562\0567\042\054\042q\137p2c1\1374\0562\0568\042\054\042q\137p2c1\1374\0562\0569\042\135\054\042p2c2\042\072\133\042q\137p2c2\1374\0562\0562\042\054\042q\137p2c2\1374\0562\0567\042\054\042q\137p2c2\1374\0562\0568\042\054\042q\137p2c2\1374\0562\0569\042\135\054\042p2c3\042\072\133\042q\137p2c3\1374\0562\0562\042\054\042q\137p2c3\1374\0562\0567\042\054\042q\137p2c3\1374\0562\0568\042\054\042q\137p2c3\1374\0562\0569\042\135\054\042p2c4\042\072\133\042q\137p2c4\1374\0562\0562\042\054\042q\137p2c4\1374\0562\0567\042\054\042q\137p2c4\1374\0562\0568\042\054\042q\137p2c4\1374\0562\0569\042\135\054\042p3c1\042\072\133\042q\137p3c1\1374\0563\0562\042\054\042q\137p3c1