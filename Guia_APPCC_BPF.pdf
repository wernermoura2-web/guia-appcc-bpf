.7.3", "proc": "4.7", "allowNA": true, "classField": "classe_p11_4.7.3", "frases": [{"texto": "A adi\\u00e7\\u00e3o de di\\u00f3xido de carbono \\u00e0 \\u00e1gua mineral natural ou \\u00e0 \\u00e1gua natural, quando houver, deve estar integrada \\u00e0 linha de envase.", "cat": "PC", "P": 1}], "P": 1, "statusField": "estado_q_p11c3_4.7.3", "resultField": "peso_q_p11c3_4.7.3"}, "q_p11c4_4.7.3": {"rects": [[425.75, 159.5, 451.4166564941406, 169.0], [452.4166564941406, 159.5, 478.0833435058594, 169.0], [479.0833435058594, 159.5, 504.75, 169.0]], "page": 10, "col": 4, "code": "4.7.3", "proc": "4.7", "allowNA": true, "classField": "classe_p11_4.7.3", "frases": [{"texto": "A adi\\u00e7\\u00e3o de di\\u00f3xido de carbono \\u00e0 \\u00e1gua mineral natural ou \\u00e0 \\u00e1gua natural, quando houver, deve estar integrada \\u00e0 linha de envase.", "cat": "PC", "P": 1}], "P": 1, "statusField": "estado_q_p11c4_4.7.3", "resultField": "peso_q_p11c4_4.7.3"}, "q_p11c1_4.7.4": {"rects": [[175.25, 173.0, 213.875, 182.5], [214.875, 173.0, 253.5, 182.5]], "page": 10, "col": 1, "code": "4.7.4", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4.7.4", "frases": [{"texto": "Na sala de envase devem ser adotadas medidas para minimizar o risco de contamina\\u00e7\\u00e3o. O piso deve possuir inclina\\u00e7\\u00e3o suficiente para facilitar o escoamento de \\u00e1gua, ralo sifonado com tampa escamote\\u00e1vel e lumin\\u00e1rias protegidas contra quebras.", "cat": "PPR", "P": 4}, {"texto": "A sala de envase deve possuir ventila\\u00e7\\u00e3o capaz de manter o ambiente livre de condensa\\u00e7\\u00e3o de vapor de \\u00e1gua.", "cat": "PPR", "P": 4}], "P": 4, "statusField": "estado_q_p11c1_4.7.4", "resultField": "peso_q_p11c1_4.7.4", "template": "Frases_4_7_4_S", "editorPrefix": "F_4_7_4_S_"}, "q_p11c2_4.7.4": {"rects": [[258.5, 173.0, 297.5, 182.5], [298.5, 173.0, 337.5, 182.5]], "page": 10, "col": 2, "code": "4.7.4", "proc": "4.7", "allowNA": false, "classField": "classe_p11_4