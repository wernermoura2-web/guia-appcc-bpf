\042Torneira espec\134u00edfica para amostragem\042\054 \042cat\042\072 \042PPR\042\175\135\054 \0424\0561\0563\042\072 \133\173\042texto\042\072 \042Limpeza e desinfec\134u00e7\134u00e3o da capta\134u00e7\134u00e3o e equipamentos\042\054 \042cat\042\072 \042PPHO\042\175\054 \173\042texto\042\072 \042Capacita\134u00e7\134u00e3o comprovada dos executantes\042\054 \042cat\042\072 \042PPR\042\175\054 \173\042texto\042\072 \042Registros das opera\134u00e7\134u00f5es\042\054 \042cat\042\072 \042PPR\042\175\135\054 \0424\0562\0562\042\072 \133\173\042texto\042\072 \042Adequa\134u00e7\134u00e3o dos materiais em contato com a \134u00e1gua\042\054 \042cat\042\072 \042PPR\042\175\054 \173\042texto\042\072 \042Superf\134u00edcies lisas\054 \134u00edntegras e higieniz\134u00e1veis\042\054 \042cat\042\072 \042PPR\042\175\135\054 \0424\0562\0567\042\072 \133\173\042texto\042\072 \042Execu\134u00e7\134u00e3o da higieniza\134u00e7\134u00e3o da canaliza\134u00e7\134u00e3o\042\054 \042cat\042\072 \042PPHO\042\175\054 \173\042texto\042\072 \042Capacita\134u00e7\134u00e3o e registros\042\054 \042cat\042\072 \042PPR\042\175\135\054 \0424\0562\0568\042\072 \133\173\042texto\042\072 \042Desmonte e frequ\134u00eancia de higieniza\134u00e7\134u00e3o\042\054 \042cat\042\072 \042PPHO\042\175\054 \173\042texto\042\072 \042Inspe\134u00e7\134u00e3o de incrusta\134u00e7\134u00f5es e revis\134u00e3o das opera\134u00e7\134u00f5es\042\054 \042cat\042\072 \042PPRO\042\175\135\054 \0424\0562\0569\042\072 \133\173\042texto\042\072 \042POP\072 m\134u00e9todo\054 concentra\134u00e7\134u00e3o\054 tempo e temperatura\042\054 \042cat\042\072 \042PPHO\042\175\054 \173\042texto\042\072 \042Exist\134u00eancia e atualiza\134u00e7\134u00e3o documental do POP\042\054 \042cat\042\072 \042PPR\042\175\135\054 \0424\0563\0562\042\072 \133\173\042texto\042\072 \042Materiais e superf\134u00edcies do reservat\134u00f3rio\042\054 \042cat\042\072 \042PPR\042\175\054 \173\042texto\042\072 \042Conserva\134u00e7\134u00e3o\05