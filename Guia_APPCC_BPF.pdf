rito e realizado exclusivamente por uma antesala. A antesala da sala de envase deve possuir lavat\\u00f3rio com torneira acionada sem contato manual, exclusivo para higiene das m\\u00e3os, dotado de sabonete l\\u00edquido inodoro, produto antiss\\u00e9ptico e sistema de secagem das m\\u00e3os acionado sem contato manual.","cat":"PPRO","P":2},{"texto":"Deve ser realizada a higiene das m\\u00e3os no lavat\\u00f3rio exclusivo da antesala da sala de envase, utilizando os produtos e o sistema de secagem dispon\\u00edveis.","cat":"PCC","P":2}],"P":2,"statusField":"estado_q_p11c4_4.7.5","resultField":"peso_q_p11c4_4.7.5","template":"Frases_4_7_5_S","editorPrefix":"F_4_7_5_S_"},"q_p11c1_4.7.6":{"rects":[[175.25,200.0,213.875,209.5],[214.875,200.0,253.5,209.5]],"page":10,"col":1,"code":"4.7.6","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.6","frases":[{"texto":"Os funcion\\u00e1rios que trabalham na sala de envase devem utilizar uniformes limpos, que devem ser trocados diariamente e serem de uso exclusivo para essa \\u00e1rea.","cat":"PPHO","P":2}],"P":2,"statusField":"estado_q_p11c1_4.7.6","resultField":"peso_q_p11c1_4.7.6"},"q_p11c2_4.7.6":{"rects":[[258.5,200.0,297.5,209.5],[298.5,200.0,337.5,209.5]],"page":10,"col":2,"code":"4.7.6","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.6","frases":[{"texto":"Os funcion\\u00e1rios que trabalham na sala de envase devem utilizar uniformes limpos, que devem ser trocados diariamente e serem de uso exclusivo para essa \\u00e1rea.","cat":"PPHO","P":2}],"P":2,"statusField":"estado_q_p11c2_4.7.6","resultField":"peso_q_p11c2_4.7.6"},"q_p11c3_4.7.6":{"rects":[[342.5,200.0,381.125,209.5],[382.125,200.0,420.75,209.5]],"page":10,"col":3,"code":"4.7.6","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.6","frases":[{"texto":"Os funcion\\u00e1rios que trabalham na sala de envase devem utilizar uniformes limpos, que devem ser trocados diariamente e serem de uso exclusivo para essa \\u00e1rea.","cat":"PPHO","P":2}],"P":2,"statusField":"estado_q_p11c3_4.7.6","resultField":"peso_q_p11c3_4.7.6"},"q_p11c4_4.7.6":{"rects":[[425.75,200.0,464.75,209.5],[465.75,200.0,504.75,209.5]],"page":10,"col":4,"code":"4.7.6","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.6","frases":[{"texto":"Os funcion\\u00e1rios que trabalham na sala de envase devem utilizar uniformes limpos, que devem ser trocados diariamente e serem de uso exclusivo para essa \\u00e1rea.","cat":"PPHO","P":2}],"P":2,"statusField":"estado_q_p11c4_4.7.6","resultField":"peso_q_p11c4_4.7.6"},"q_p11c1_4.7.8":{"rects":[[175.25,213.5,213.875,223.0],[214.875,213.5,253.5,223.0]],"page":10,"col":1,"code":"4.7.8","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.8","frases":[{"texto":"A sala de envase e os equipamentos devem ser higienizados quantas vezes forem necess\\u00e1rias e imediatamente ap\\u00f3s o t\\u00e9rmino do trabalho.","cat":"PPRO","P":3},{"texto":"Quando aplic\\u00e1vel, a higieniza\\u00e7\\u00e3o deve contemplar o desmonte dos equipamentos na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.","cat":"PPRO","P":3}],"P":3,"statusField":"estado_q_p11c1_4.7.8","resultField":"peso_q_p11c1_4.7.8","template":"Frases_4_7_8_S","editorPrefix":"F_4_7_8_S_"},"q_p11c2_4.7.8":{"rects":[[258.5,213.5,297.5,223.0],[298.5,213.5,337.5,223.0]],"page":10,"col":2,"code":"4.7.8","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.8","frases":[{"texto":"A sala de envase e os equipamentos devem ser higienizados quantas vezes forem necess\\u00e1rias e imediatamente ap\\u00f3s o t\\u00e9rmino do trabalho.","cat":"PPRO","P":3},{"texto":"Quando aplic\\u00e1vel, a higieniza\\u00e7\\u00e3o deve contemplar o desmonte dos equipamentos na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.","cat":"PPRO","P":3}],"P":3,"statusField":"estado_q_p11c2_4.7.8","resultField":"peso_q_p11c2_4.7.8","template":"Frases_4_7_8_S","editorPrefix":"F_4_7_8_S_"},"q_p11c3_4.7.8":{"rects":[[342.5,213.5,381.125,223.0],[382.125,213.5,420.75,223.0]],"page":10,"col":3,"code":"4.7.8","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.8","frases":[{"texto":"A sala de envase e os equipamentos devem ser higienizados quantas vezes forem necess\\u00e1rias e imediatamente ap\\u00f3s o t\\u00e9rmino do trabalho.","cat":"PPRO","P":3},{"texto":"Quando aplic\\u00e1vel, a higieniza\\u00e7\\u00e3o deve contemplar o desmonte dos equipamentos na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.","cat":"PPRO","P":3}],"P":3,"statusField":"estado_q_p11c3_4.7.8","resultField":"peso_q_p11c3_4.7.8","template":"Frases_4_7_8_S","editorPrefix":"F_4_7_8_S_"},"q_p11c4_4.7.8":{"rects":[[425.75,213.5,464.75,223.0],[465.75,213.5,504.75,223.0]],"page":10,"col":4,"code":"4.7.8","proc":"4.7","allowNA":false,"classField":"classe_p11_4.7.8","frases":[{"texto":"A sala de envase e os equipamentos devem ser higienizados quantas vezes forem necess\\u00e1rias e imediatamente ap\\u00f3s o t\\u00e9rmino do trabalho.","cat":"PPRO","P":3},{"texto":"Quando aplic\\u00e1vel, a higieniza\\u00e7\\u00e3o deve contemplar o desmonte dos equipamentos na freq\\u00fc\\u00eancia definida pelo estabelecimento industrial.","cat":"PPRO","P":3}],"P":3,"statusField":"estado_q_p11c4_4.7.8","resultField":"peso_q_p11c4_4.7.8","template":"Frases_4_7_8_S","editorPrefix":"F_4_7_8_S_"},"q_p12c1_4.10.1":{"rects":[[528.25,106.75,577.25,120.75],[528.25,122.75,577.25,136.75]],"page":11,"col":1,"code":"4.10.1","proc":"4.10","allowNA":false,"classField":"classe_p12_4.10.1","frases":[{"texto":"O estabelecimento industrial deve implementar e documentar o controle de qualidade da \\u00e1gua mineral natural, da \\u00e1gua natural, das embalagens e, quando utilizado, do di\\u00f3xido de carbono.","cat":"PPRO","P":4}],"P":4,"statusField":"estado_q_p12c1_4.10.1","resultField":"peso_q_p12c1_4.10.1"},"q_p12c1_4.10.2":{"rects":[[528.25,166.75,577.25,180.75],[528.25,182.75,577.25,196.75]],"page":11,"col":1,"code":"4.10.2","proc":"4.10","allowNA":false,"classField":"classe_p12_4.10.2","frases":[{"texto":"As an\\u00e1lises laboratoriais para o controle e o monitoramento da qualidade da \\u00e1gua mineral natural e da \\u00e1gua natural devem ser realizadas em laborat\\u00f3rio pr\\u00f3prio ou terceirizado","cat":"PPRO","P":4}],"P":4,"statusField":"estado_q_p12c1_4.10.2","resultField":"peso_q_p12c1_4.10.2"},"q_p12c1_4.10.3":{"rects":[[528.25,227.5,577.25,241.5],[528.25,243.5,577.25,257.5]],"page":11,"col":1,"code":"4.10.3","proc":"4.10","allowNA":false,"classField":"classe_p12_4.10.3","frases":[{"texto":"As an\\u00e1lises microbiol\\u00f3gicas e de contaminantes qu\\u00edmicos da \\u00e1gua mineral natural e da \\u00e1gua natural devem atender ao disposto em legisla\\u00e7\\u00e3o especifica.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p12c1_4.10.3","resultField":"peso_q_p12c1_4.10.3"},"q_p12c1_4.10.4":{"rects":[[528.25,288.25,577.25,302.25],[528.25,304.25,577.25,318.25]],"page":11,"col":1,"code":"4.10.4","proc":"4.10","allowNA":false,"classField":"classe_p12_4.10.4","frases":[{"texto":"O estabelecimento industrial deve estabelecer plano de amostragem, especificando o n\\u00famero de amostras, o local de coleta, os par\\u00e2metros anal\\u00edticos e a frequ\\u00eancia a ser realizada, envolvendo as diversas etapas da industrializa\\u00e7\\u00e3o.","cat":"PPRO","P":4},{"texto":"O estabelecimento industrial deve executar o plano de amostragem e definir os limites de aceita\\u00e7\\u00e3o a serem determinados nas amostras coletadas, segundo o plano estabelecido.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p12c1_4.10.4","resultField":"peso_q_p12c1_4.10.4","template":"Frases_4_10_4_S","editorPrefix":"F_4_10_4_S_"},"q_p12c1_4.10.5":{"rects":[[528.25,348.25,577.25,362.25],[528.25,364.25,577.25,378.25]],"page":11,"col":1,"code":"4.10.5","proc":"4.10","allowNA":false,"classField":"classe_p12_4.10.5","frases":[{"texto":"A \\u00e1gua mineral natural ou a \\u00e1gua natural envasada deve apresentar composi\\u00e7\\u00e3o equivalente \\u00e0 respectiva \\u00e1gua emergente da fonte ou po\\u00e7o, conforme especificada nas an\\u00e1lises laboratoriais efetuadas pelo \\u00f3rg\\u00e3o competente do Minist\\u00e9rio das Minas e Energia.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p12c1_4.10.5","resultField":"peso_q_p12c1_4.10.5"},"q_p12c1_4.10.6":{"rects":[[528.25,409.0,577.25,423.0],[528.25,425.0,577.25,439.0]],"page":11,"col":1,"code":"4.10.6","proc":"4.10","allowNA":false,"classField":"classe_p12_4.10.6","frases":[{"texto":"O estabelecimento industrial deve adotar as medidas corretivas em caso de desvios dos par\\u00e2metros estabelecidos.","cat":"PPRO","P":5},{"texto":"Essas medidas devem estar documentadas.","cat":"PPRO","P":5}],"P":5,"statusField":"estado_q_p12c1_4.10.6","resultField":"peso_q_p12c1_4.10.6","template":"Frases_4_10_6_S","editorPrefix":"F_4_10_6_S_"},"q_p12c1_4.12.6":{"rects":[[528.25,469.0,577.25,483.0],[528.25,485.0,577.25,499.0],[528.25,501.0,577.25,515.0]],"page":11,"col":1,"code":"4.12.6","proc":"4.10","allowNA":true,"classField":"classe_p12_4.12.6","frases":[{"texto":"O estabelecimento industrial deve dispor de documenta\\u00e7\\u00e3o que comprove a qualidade de cada carga do di\\u00f3xido de carbono.","cat":"PPRO","P":2}],"P":2,"statusField":"estado_q_p12c1_4.12.6","resultField":"peso_q_p12c1_4.12.6"},"q_p13c1_4.11.1":{"rects":[[528.25,106.75,577.25,120.75],[528.25,122.75,577.25,136.75]],"page":12,"col":1,"code":"4.11.1","proc":"4.11","allowNA":false,"classField":"classe_p13_4.11.1","frases":[{"texto":"Os manipuladores de alimentos devem ser supervisionados, sendo capacitados periodicamente em: higiene pessoal, manipula\\u00e7\\u00e3o higi\\u00eanica dos alimentos e em doen\\u00e7as transmitidas por alimentos.","cat":"PPHO","P":2}],"P":2,"statusField":"estado_q_p13c1_4.11.1","resultField":"peso_q_p13c1_4.11.1"},"q_p13c1_4.11.2":{"rects":[[528.25,223.75,577.25,237.75],[528.25,239.75,577.25,253.75]],"page":12,"col":1,"code":"4.11.2","proc":"4.11","allowNA":false,"classField":"classe_p13_4.11.2","frases":[{"texto":"A responsabilidade pela industrializa\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural deve ser exercida pelo respons\\u00e1vel t\\u00e9cnico, respons\\u00e1vel legal ou propriet\\u00e1rio do estabelecimento industrial.","cat":"PPRO","P":2}],"P":2,"statusField":"estado_q_p13c1_4.11.2","resultField":"peso_q_p13c1_4.11.2"},"q_p13c1_4.11.3":{"rects":[[528.25,340.75,577.25,354.75],[528.25,356.75,577.25,370.75]],"page":12,"col":1,"code":"4.11.3","proc":"4.11","allowNA":false,"classField":"classe_p13_4.11.3","frases":[{"texto":"A responsabilidade deve ser exercida por funcion\\u00e1rio que tenha realizado curso de capacita\\u00e7\\u00e3o, com carga hor\\u00e1ria m\\u00ednima de 40 \(quarenta\) horas, abordando os seguintes temas:a\) Microbiologia de Alimentos;b\) Industrializa\\u00e7\\u00e3o da \\u00e1gua mineral natural e da \\u00e1gua natural;c\) Boas Pr\\u00e1ticas ;d\) Sistema de An\\u00e1lise de Perigos e Pontos Cr\\u00edticos de Controle - APPCC.","cat":"PPRO","P":3}],"P":3,"statusField":"estado_q_p13c1_4.11.3","resultField":"peso_q_p13c1_4.11.3"},"q_p13c1_4.11.4":{"rects":[[528.25,457.75,577.25,471.75],[528.25,473.75,577.25,487.75]],"page":12,"col":1,"code":"4.11.4","proc":"4.11","allowNA":false,"classField":"classe_p13_4.11.4","frases":[{"texto":"O estabelecimento industrial deve dispor do certificado de capacita\\u00e7\\u00e3o dos manipuladores e do certificado do respons\\u00e1vel pela industrializa\\u00e7\\u00e3o, devidamente datado, contendo a carga hor\\u00e1ria e o conte\\u00fado program\\u00e1tico dos cursos.","cat":"PPHO","P":3}],"P":3,"statusField":"estado_q_p13c1_4.11.4","resultField":"peso_q_p13c1_4.11.4"}},"grupos":{"p1c1":["q_p1c1_4.1.1","q_p1c1_4.1.2","q_p1c1_4.1.3"],"p1c2":["q_p1c2_4.1.1","q_p1c2_4.1.2","q_p1c2_4.1.3"],"p1c3":["q_p1c3_4.1.1","q_p1c3_4.1.2","q_p1c3_4.1.3"],"p1c4":["q_p1c4_4.1.1","q_p1c4_4.1.2","q_p1c4_4.1.3"],"p2c1":["q_p2c1_4.2.2","q_