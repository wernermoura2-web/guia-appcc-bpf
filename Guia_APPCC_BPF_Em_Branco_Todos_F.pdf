 a <60%=3; 60 a 75%=4; >75%=5. Pontua\347\343o=NC x P. N/A conforme item.';for\(var i=0;i<rs.length;i++\){\nif\(i>=rs.length\)continue;var r=rs[i],nc=CFG.pesos[r.c]||1;var vals={};var guideText='F'+\(i+1\)+' - '+c.frases[i].texto+'\\nBPF/APPCC: '+String\(c.frases[i].cat\).replace\('PPHO','POP'\)+'\\nFundamento da classifica\347\343o: '+\(c.frases[i].fundamento||c.frases[i].consideracao||''\)+'\\nOrienta\347\343o: '+c.frases[i].orientacao;var guideField=editorF.call\(this,'ed_text_'+i\);if\(guideField\)guideField.textSize=c.code==="4.10.3"?5.2:6;vals['ed_text_'+i]=quebrarLinhas\(guideText,c.code==="4.10.3"?264:528,c.code==="4.10.3"?5.2:6\).join\('\\r'\);vals['ed_cat_'+i]=r.c;vals['ed_obs_'+i]=r.o;for\(var nm in vals\){var z=editorF.call\(this,nm\);if\(z\)put.call\(this,ACTIVE.prefix+nm,vals[nm]\);}preencherPontuacaoFrase.call\(this,i,r.c,c.frases[i].P||c.P\);for\(var j=0;j<3;j++\){var a=['S','N','A'][j],z=editorF.call\(this,'ed_b_'+i+'_'+a\);if\(z\)respostaVisual.call\(this,ACTIVE.prefix+'ed_b_'+i+'_'+a,r.a===a\);}}\nvar z=avaliar.call\(this,key,d\),rf=editorF.call\(this,'ed_resumo'\);if\(rf\)rf.value=z.complete?\(z.a==='A'?'Item n\343o aplic\341vel':\(z.a==='N'?'N\343o':'Sim'\)+' | APPCC informativo: '+z.num+' / '+z.den\):'Item pendente: avalie todas as frases aplic\341veis.';}finally{EDITOR_BUSY=false;}}\nfunction nomeUnidade\(c\){if\(c.proc==='4.1'\)return 'Capta\347\343o '+c.col;if\(c.proc==='4.2'\)return 'Condu\347\343o '+c.col;if\(c.proc==='4.3'\)return 'Reservat\363rio / capta\347\343o '+c.col+' \(p\341gina '+\(c.page+1\)+'\)';if\(c.proc==='4.5'\)return ['Retorn\341veis','Descart\341veis','R\363tulos','Saneantes'][c.col-1];if\(c.proc==='4.6'||c.proc==='4.7'\)return \(c.page===7||c.page===9?'Retorn\341veis':'Descart\341veis'\)+' - '+\(c.col===4?'Tampas':'Linha '+c.col\);return 'Processo '+c.proc;}\nfunction abrirFrases\(key\){if\(CLOSE_DOC\)excluirPaginaFrases\(\);if\(OPEN_BUSY||EDITOR_BUSY||SAVE_BUSY\)return;OPEN_BUSY=true;try{if\(ACTIVE\){if\(ACTIVE.key===key